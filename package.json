{
  "name": "mon-carburant",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-fuel-data.js && node scripts/build-station-waves.js && astro build",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/fetch-fuel-data.js && node scripts/build-station-waves.js && astro build",
    "fetch-fuel": "node scripts/fetch-fuel-data.js",
    "fetch-fuel:check": "node scripts/fetch-fuel-data.js --check",
    "fetch-brands": "node scripts/fetch-brand-map.js",
    "waves": "node scripts/build-station-waves.js",
    "waves:plan": "node scripts/build-station-waves.js --dry-run",
    "waves:replan": "node scripts/build-station-waves.js --replan",
    "waves:replan:plan": "node scripts/build-station-waves.js --replan --dry-run",
    "preview:stations": "STATIONS_ROLLOUT_ALL=1 astro build",
    "frontier": "node scripts/frontier-prices.js",
    "frontier:chart": "node scripts/build-frontier-chart.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/manrope": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "adm-zip": "^0.5.17",
    "astro": "^7.2.0",
    "astro-seo": "^0.8.4",
    "fast-xml-parser": "^5.7.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  }
}
