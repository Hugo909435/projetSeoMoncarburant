---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import statsNational from '../data/fuel/stats-national.json';
import statsByDepartment from '../data/fuel/stats-by-department.json';
import fuelMeta from '../data/fuel/meta.json';
import departmentsData from '../data/departments.json';

const allArticles = await getCollection('blog', ({ data }) => !data.draft);
allArticles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestArticles = allArticles.slice(0, 6);
const popularArticles = allArticles.slice(0, 3);

const allPiliers = await getCollection('piliers', ({ data }) => !data.draft);
const featuredPilier = allPiliers[0];

const categories = [
  {
    slug: 'economies',
    label: 'Économies de carburant',
    desc: 'Techniques d\'éco-conduite, comparer les prix, cartes essence : réduisez votre facture dès aujourd\'hui.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
    color: '#059669',
  },
  {
    slug: 'carburants',
    label: 'Types de carburants',
    desc: 'SP95, E10, diesel, E85, GPL, hydrogène : comprendre les différences et choisir le bon carburant.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z"/></svg>',
    color: '#0369a1',
  },
  {
    slug: 'entretien',
    label: 'Entretien du véhicule',
    desc: 'Un véhicule bien entretenu consomme moins. Pneus, filtres, vidanges : les bons gestes.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
    color: '#b45309',
  },
];

const MAIN_FUELS = [
  { key: 'SP95',   label: 'SP95',   color: '#16a34a' },
  { key: 'SP98',   label: 'SP98',   color: '#2563eb' },
  { key: 'Gazole', label: 'Gazole', color: '#374151' },
  { key: 'E85',    label: 'E85',    color: '#E87722' },
] as const;

const lastUpdate = fuelMeta.lastUpdate
  ? new Date(fuelMeta.lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const POPULAR_DEPT_NUMS = ['75', '13', '69', '33', '31', '59', '44', '06'];
const depts = departmentsData as Record<string, { name: string; slug: string }>;
const deptStats = statsByDepartment as Record<string, Record<string, number | null>>;

const popularDepts = POPULAR_DEPT_NUMS.map(num => ({
  num,
  name: depts[num]?.name ?? '',
  slug: depts[num]?.slug ?? '',
  gazole: deptStats[num]?.Gazole ?? null,
})).filter(d => d.name);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mon Carburant',
  url: 'https://mon-carburant.com',
  description: 'Économisez sur le carburant, roulez plus malin',
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://mon-carburant.com/prix-carburants/?cp={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mon Carburant',
  url: 'https://mon-carburant.com',
  logo: { '@type': 'ImageObject', url: 'https://mon-carburant.com/images/logo.png' },
  description: 'Média éditorial indépendant spécialisé dans le carburant, les comparatifs de prix et l\'entretien automobile.',
  foundingDate: '2026',
  areaServed: 'FR',
  inLanguage: 'fr-FR',
  sameAs: [
    'https://www.instagram.com/moncarburant/',
    'https://x.com/mon_carburant',
  ],
};
---

<BaseLayout
  title="Comparateur Carburant : trouvez la station la moins chère"
  description="Comparez gratuitement les prix du carburant en temps réel grâce aux données officielles. Trouvez la station la moins chère près de chez vous : SP95, SP98, Gazole, E85."
  canonical="https://mon-carburant.com/"
  jsonLd={[websiteSchema, organizationSchema]}
>
  <!-- Hero -->
  <section class="hero" aria-label="Introduction">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Le média carburant des automobilistes français</p>
        <h1 class="hero-title">
          Économisez sur le carburant,<br />
          <span class="hero-title-accent">roulez plus malin</span>
        </h1>
        <p class="hero-subtitle">
          Conseils d'éco-conduite, comparatifs carburants et entretien malin. Tout pour réduire votre budget mobilité sans changer de vie.
        </p>
        <div class="hero-actions">
          <a href="#comparateur" class="btn-comparateur">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg>
            Comparer les prix près de chez moi
          </a>
          <a href="/blog" class="btn-secondary">Lire nos articles</a>
        </div>
        <div class="hero-stats" aria-label="Chiffres clés">
          <div class="stat">
            <strong>15 à 30%</strong>
            <span>d'économies possibles avec l'éco-conduite</span>
          </div>
          <div class="stat-sep" aria-hidden="true"></div>
          <div class="stat">
            <strong>{fuelMeta.totalStations.toLocaleString('fr-FR')} stations</strong>
            <span>référencées en France</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Widgets carburant -->
  <section id="comparateur" class="section-fuel-home" aria-label="Prix des carburants aujourd'hui">
    <div class="container">
      <div class="fuel-home-grid">

        <!-- Gauche : prix nationaux + recherche rapide -->
        <div class="fuel-home-left">

          <!-- Widget a : Prix moyens nationaux -->
          <div class="widget-nat">
            <div class="widget-nat-head">
              <h2 class="widget-title">Prix moyens nationaux aujourd'hui</h2>
              {lastUpdate && (
                <span class="update-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {lastUpdate}
                </span>
              )}
            </div>
            <div class="nat-prices-grid">
              {MAIN_FUELS.map(({ key, label, color }) => {
                const price = statsNational[key as keyof typeof statsNational];
                return (
                  <div class="nat-price-item" style={`--c: ${color}`}>
                    <span class="nat-price-label">{label}</span>
                    <span class="nat-price-value">
                      {price != null ? price.toFixed(3) : '—'}
                      <small>€/L</small>
                    </span>
                  </div>
                );
              })}
            </div>
            <a href="/prix-carburants/" class="widget-cta">
              Voir le comparateur complet →
            </a>
          </div>

          <!-- Widget b : Recherche rapide -->
          <div class="widget-search">
            <h3 class="widget-title">Trouver les stations les moins chères</h3>
            <p class="widget-search-desc">Saisissez votre code postal pour comparer les prix près de chez vous.</p>
            <div class="qs-row">
              <input
                type="text"
                id="qs-cp"
                class="qs-input"
                inputmode="numeric"
                pattern="\d{2,5}"
                placeholder="Ex : 75001"
                maxlength="5"
                aria-label="Code postal"
              />
              <button id="qs-btn" class="qs-btn" type="button">
                Trouver les meilleurs prix
              </button>
            </div>
            <p id="qs-error" class="qs-error" hidden aria-live="polite">
              Saisissez un code postal valide (2 à 5 chiffres).
            </p>
          </div>

        </div>

        <!-- Droite : départements populaires -->
        <div class="widget-depts">
          <h2 class="widget-title">Prix Gazole par département</h2>
          <ul class="dept-list" role="list">
            {popularDepts.map(d => (
              <li>
                <a href={`/prix-carburants/${d.slug}/`} class="dept-item">
                  <span class="dept-name">
                    <span class="dept-num">{d.num}</span>
                    {d.name}
                  </span>
                  <span class="dept-price">
                    {d.gazole != null ? d.gazole.toFixed(3) + ' €/L' : '—'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/prix-carburants/" class="dept-all-link">Voir tous les départements →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Intro éditoriale -->
  <section class="section-intro" aria-label="Notre mission">
    <div class="container intro-inner">
      <p>
        Chaque année, le carburant représente une part significative du budget des ménages français. Avec des prix
        qui varient du simple au double entre les stations d'autoroute et la grande distribution, il n'est pas rare
        d'économiser 10 à 20 centimes par litre en choisissant la bonne station. Sur un plein de 50 litres, cela
        représente jusqu'à 10 euros d'économies, soit plus de 200 euros par an pour un conducteur moyen.
      </p>
      <p>
        <strong>Mon Carburant</strong> est né de cette réalité : l'information sur les prix existe (elle est publiée
        chaque jour par le gouvernement), mais elle reste peu accessible. Notre mission est de vous aider à naviguer
        dans cette complexité. Nous agrégeons quotidiennement les données officielles du ministère de l'Économie
        pour vous proposer un comparateur de prix couvrant plus de {fuelMeta.totalStations.toLocaleString('fr-FR')} stations
        en France métropolitaine et dans les DOM.
      </p>
      <p>
        Mais notre mission ne s'arrête pas aux chiffres. Nous publions des guides pratiques sur l'éco-conduite,
        des comparatifs entre carburants, et des conseils d'entretien pour que votre véhicule consomme le moins
        possible. Que vous rouliez au diesel, à l'essence, au GPL ou au bioéthanol, vous trouverez ici les
        informations dont vous avez besoin pour faire les bons choix, sans jargon technique inutile.
      </p>
    </div>
  </section>

  <!-- Derniers articles -->
  {latestArticles.length > 0 && (
    <section class="section-articles" aria-label="Derniers articles">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Nos derniers conseils</h2>
          <a href="/blog" class="section-link">Voir tous les articles →</a>
        </div>
        <div class="articles-grid">
          {latestArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Thématiques -->
  <section class="section-categories" aria-label="Nos thématiques">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Nos thématiques</h2>
        <p class="section-desc">3 angles d'approche pour maîtriser votre budget carburant</p>
      </div>
      <div class="categories-grid">
        {categories.map((cat) => (
          <a href={`/categorie/${cat.slug}`} class="category-card" style={`--cat-color: ${cat.color}`}>
            <span class="cat-icon" aria-hidden="true" set:html={cat.icon} />
            <h3 class="cat-label">{cat.label}</h3>
            <p class="cat-desc">{cat.desc}</p>
            <span class="cat-link">Découvrir →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Article du moment (pilier) -->
  {featuredPilier && (
    <section class="section-pilier" aria-label="Article du moment">
      <div class="container">
        <div class="pilier-feature">
          <div class="pilier-feature-image">
            <img
              src={featuredPilier.data.featuredImage}
              alt={featuredPilier.data.imageAlt}
              width="700"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="pilier-feature-content">
            <p class="pilier-eyebrow">Guide complet</p>
            <h2 class="pilier-feature-title">{featuredPilier.data.title}</h2>
            <p class="pilier-feature-excerpt">{featuredPilier.data.excerpt}</p>
            <a href={`/piliers/${featuredPilier.data.slug}/`} class="btn-primary">
              Lire le guide complet →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="section-newsletter" aria-label="Newsletter">
    <div class="container">
      <Newsletter />
    </div>
  </section>

  <!-- Articles populaires -->
  {popularArticles.length > 0 && (
    <section class="section-popular" aria-label="Articles populaires">
      <div class="container">
        <h2 class="section-title">Articles populaires</h2>
        <div class="popular-list">
          {popularArticles.map((article, i) => (
            <a href={`/blog/${article.data.slug}/`} class="popular-item">
              <span class="popular-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="popular-info">
                <span class="badge popular-badge">{article.data.category}</span>
                <h3 class="popular-title">{article.data.title}</h3>
                <p class="popular-meta">
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(article.data.publishedAt)}
                  </time>
                  · {article.data.readingTime} min
                </p>
              </div>
              <img
                src={article.data.featuredImage}
                alt={article.data.imageAlt}
                width="120"
                height="80"
                loading="lazy"
                decoding="async"
                class="popular-img"
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const btn = document.getElementById('qs-btn');
  const input = document.getElementById('qs-cp') as HTMLInputElement | null;
  const errEl = document.getElementById('qs-error');

  function handleSearch() {
    const cp = input?.value.trim() ?? '';
    if (!/^\d{2,5}$/.test(cp)) {
      if (errEl) errEl.hidden = false;
      return;
    }
    if (errEl) errEl.hidden = true;
    window.location.href = `/prix-carburants/?cp=${cp}`;
  }

  btn?.addEventListener('click', handleSearch);
  input?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') handleSearch();
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a4a68 100%);
    color: #fff;
    padding: 4rem 0 5rem;
  }

  .hero-inner {
    max-width: 64rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 1.25rem;
  }

  .hero-title-accent {
    color: var(--color-accent);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    max-width: 45ch;
    line-height: 1.65;
    margin: 0 0 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .btn-comparateur {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f59e0b;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(245 158 11 / 0.4);
  }

  .btn-comparateur:hover {
    background: #fbbf24;
    transform: translateY(-1px);
  }

  .hero .btn-secondary {
    border-color: rgba(255 255 255 / 0.3);
    color: #fff;
  }

  .hero .btn-secondary:hover {
    border-color: #fff;
    background: rgba(255 255 255 / 0.1);
    color: #fff;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat strong {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-accent);
  }

  .stat span {
    font-size: 0.8125rem;
    color: #94a3b8;
  }

  .stat-sep {
    width: 1px;
    height: 2.5rem;
    background: rgba(255 255 255 / 0.15);
  }

  /* ── Intro éditoriale ── */
  .section-intro {
    padding: 3rem 0;
    background: #f9fafb;
    border-bottom: 1px solid var(--color-border);
  }

  .intro-inner {
    max-width: 72ch;
  }

  .intro-inner p {
    font-size: 1rem;
    line-height: 1.75;
    color: #374151;
    margin: 0 0 1rem;
  }

  .intro-inner p:last-child {
    margin-bottom: 0;
  }

  /* ── Widgets carburant ── */
  .section-fuel-home {
    padding: 3rem 0;
  }

  .fuel-home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .fuel-home-grid {
      grid-template-columns: 1fr 340px;
      align-items: start;
    }
  }

  .fuel-home-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1rem;
  }

  /* Widget a : prix nationaux */
  .widget-nat {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    padding: 1.5rem;
  }

  .widget-nat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .widget-nat-head .widget-title {
    margin: 0;
  }

  .update-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: #64748b;
    background: #f1f5f9;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .nat-prices-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 480px) {
    .nat-prices-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .nat-price-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-top: 3px solid var(--c);
    border-radius: 0.625rem;
    padding: 0.875rem 1rem;
  }

  .nat-price-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 0.375rem;
  }

  .nat-price-value {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--c);
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .nat-price-value small {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .widget-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .widget-cta:hover {
    text-decoration: underline;
  }

  /* Widget b : recherche rapide */
  .widget-search {
    background: var(--color-primary);
    border-radius: 0.875rem;
    padding: 1.5rem;
    color: #fff;
  }

  .widget-search .widget-title {
    color: #fff;
  }

  .widget-search-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: -0.5rem 0 1rem;
  }

  .qs-row {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .qs-input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 1rem;
    border: 2px solid rgba(255 255 255 / 0.2);
    border-radius: 0.5rem;
    background: rgba(255 255 255 / 0.08);
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .qs-input::placeholder {
    color: #64748b;
  }

  .qs-input:focus {
    border-color: var(--color-accent);
  }

  .qs-btn {
    padding: 0.7rem 1.25rem;
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .qs-btn:hover {
    background: #d0651a;
  }

  .qs-error {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: #fca5a5;
  }

  /* Widget c : départements */
  .widget-depts {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    padding: 1.5rem;
  }

  .dept-list {
    list-style: none;
    padding: 0;
