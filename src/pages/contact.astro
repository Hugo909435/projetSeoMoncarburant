---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Mon Carburant"
  description="Contactez l'équipe de Mon Carburant pour toute question, suggestion ou opportunité éditoriale. Réponse sous 48h ouvrées."
  canonical="https://mon-carburant.com/contact/"
>
  <div class="contact-page">
    <div class="container contact-inner">
      <header class="contact-header">
        <h1>Nous contacter</h1>
        <p class="contact-subtitle">
          Une question, une suggestion, un partenariat éditorial ? Écrivez-nous. <strong>Réponse sous 48h ouvrées.</strong>
        </p>
      </header>

      <div class="contact-grid">
        <!-- Formulaire -->
        <div class="contact-form-wrapper">
          <form
            id="contact-form"
            class="contact-form"
            action="https://formspree.io/f/[VOTRE_ID_FORMSPREE]"
            method="POST"
            novalidate
          >
            <div class="form-group">
              <label for="name">Nom complet <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                minlength="2"
                maxlength="100"
                autocomplete="name"
                placeholder="Thomas Dupont"
                aria-required="true"
              />
              <span class="field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="thomas@exemple.fr"
                aria-required="true"
              />
              <span class="field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="subject">Sujet <span aria-hidden="true">*</span></label>
              <select id="subject" name="subject" required aria-required="true">
                <option value="" disabled selected>Choisissez un sujet</option>
                <option value="question">Question générale</option>
                <option value="partenariat">Partenariat éditorial</option>
                <option value="correction">Signaler une erreur</option>
                <option value="autre">Autre</option>
              </select>
              <span class="field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="message">Message <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                minlength="20"
                maxlength="2000"
                rows="6"
                placeholder="Votre message..."
                aria-required="true"
              ></textarea>
              <span class="field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-rgpd">
              <label class="checkbox-label">
                <input type="checkbox" name="rgpd" required aria-required="true" />
                <span>
                  J'accepte que mes données soient traitées pour répondre à ma demande, conformément à la
                  <a href="/politique-confidentialite">politique de confidentialité</a>.
                </span>
              </label>
              <span class="field-error" role="alert" aria-live="polite"></span>
            </div>

            <button type="submit" class="btn-primary">
              Envoyer le message
            </button>

            <div id="form-success" class="form-success" hidden role="alert" aria-live="polite">
              Merci ! Votre message a bien été envoyé. Nous vous répondrons sous 48h ouvrées.
            </div>
            <div id="form-error" class="form-error" hidden role="alert" aria-live="polite">
              Une erreur est survenue. Veuillez réessayer ou nous contacter directement par email.
            </div>
          </form>
        </div>

        <!-- Infos de contact -->
        <aside class="contact-info">
          <h2>Autres moyens de nous joindre</h2>
          <dl class="info-list">
            <div class="info-item">
              <dt>Email</dt>
              <dd>contact@mon-carburant.com</dd>
            </div>
            <div class="info-item">
              <dt>Délai de réponse</dt>
              <dd>48h ouvrées maximum</dd>
            </div>
            <div class="info-item">
              <dt>Partenariats</dt>
              <dd>partenariats@mon-carburant.com</dd>
            </div>
          </dl>

          <div class="contact-faq">
            <h3>Questions fréquentes</h3>
            <ul>
              <li>
                <strong>Proposer un article :</strong> nous n'acceptons pas de contributions externes non sollicitées.
              </li>
              <li>
                <strong>Partenariat commercial :</strong> utilisez le formulaire ou l'email dédié.
              </li>
              <li>
                <strong>Droits de reproduction :</strong> nos articles sont librement citables avec source et lien.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Validation côté client du formulaire de contact
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Réinitialiser les messages
      clearErrors();

      if (!validateForm()) return;

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Envoi en cours…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          if (successMsg) successMsg.hidden = false;
        } else {
          throw new Error('Server error');
        }
      } catch {
        if (errorMsg) errorMsg.hidden = false;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Envoyer le message';
        }
      }
    });
  }

  function clearErrors() {
    document.querySelectorAll<HTMLSpanElement>('.field-error').forEach((el) => {
      el.textContent = '';
    });
    if (successMsg) successMsg.hidden = true;
    if (errorMsg) errorMsg.hidden = true;
  }

  function validateForm(): boolean {
    if (!form) return false;
    let valid = true;

    const name = form.querySelector<HTMLInputElement>('#name');
    if (name && name.value.trim().length < 2) {
      showError(name, 'Le nom doit contenir au moins 2 caractères.');
      valid = false;
    }

    const email = form.querySelector<HTMLInputElement>('#email');
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      showError(email, 'Veuillez saisir une adresse email valide.');
      valid = false;
    }

    const subject = form.querySelector<HTMLSelectElement>('#subject');
    if (subject && !subject.value) {
      showError(subject, 'Veuillez choisir un sujet.');
      valid = false;
    }

    const message = form.querySelector<HTMLTextAreaElement>('#message');
    if (message && message.value.trim().length < 20) {
      showError(message, 'Le message doit contenir au moins 20 caractères.');
      valid = false;
    }

    const rgpd = form.querySelector<HTMLInputElement>('[name="rgpd"]');
    if (rgpd && !rgpd.checked) {
      const errorEl = rgpd.closest('.form-rgpd')?.querySelector<HTMLSpanElement>('.field-error');
      if (errorEl) errorEl.textContent = 'Veuillez accepter les conditions.';
      valid = false;
    }

    return valid;
  }

  function showError(field: HTMLElement, message: string) {
    const errorEl = field.parentElement?.querySelector<HTMLSpanElement>('.field-error');
    if (errorEl) errorEl.textContent = message;
    field.setAttribute('aria-invalid', 'true');
  }
</script>

<style>
  .contact-page {
    padding: 3rem 0 5rem;
  }

  .contact-inner {
    max-width: 72rem;
  }

  .contact-header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .contact-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .contact-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }

  /* Formulaire */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-group label span {
    color: var(--color-accent);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: #fff;
    transition: border-color 0.15s ease;
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(15 45 63 / 0.1);
  }

  .form-group input[aria-invalid="true"],
  .form-group select[aria-invalid="true"],
  .form-group textarea[aria-invalid="true"] {
    border-color: #dc2626;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 140px;
  }

  .field-error {
    font-size: 0.8125rem;
    color: #dc2626;
    min-height: 1rem;
  }

  .form-rgpd {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 0.125rem;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-primary);
  }

  .checkbox-label span {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .checkbox-label a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .form-success {
    padding: 1rem 1.25rem;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: 0.5rem;
    color: #166534;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .form-error {
    padding: 1rem 1.25rem;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 0.5rem;
    color: #991b1b;
    font-size: 0.9375rem;
  }

  /* Infos de contact */
  .contact-info h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 2rem;
    padding: 1.25rem;
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .info-item dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .info-item dd {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0;
  }

  .contact-faq h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .contact-faq ul {
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .contact-faq li {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
</style>
