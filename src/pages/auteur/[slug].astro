---
// Page auteur avec schema.org Person
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.data.slug },
    props: { author: author.data },
  }));
}

interface AuthorData {
  name: string;
  slug: string;
  bio: string;
  photo: string;
  photoAlt?: string;
  expertise: string[];
  email?: string;
  website?: string;
  linkedin?: string;
}

interface Props {
  author: AuthorData;
}

const { author } = Astro.props;

const articles = await getCollection('blog', ({ data }) => !data.draft && data.author === author.slug);
articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageUrl = `https://mon-carburant.com/auteur/${author.slug}/`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  description: author.bio,
  url: pageUrl,
  image: author.photo.startsWith('http') ? author.photo : `https://mon-carburant.com${author.photo}`,
  knowsAbout: author.expertise,
  worksFor: {
    '@type': 'Organization',
    name: 'Mon Carburant',
    url: 'https://mon-carburant.com',
  },
};
---

<BaseLayout
  title={`${author.name} - Auteur sur Mon Carburant`}
  description={`${author.bio.slice(0, 150)}…`}
  canonical={pageUrl}
  image={author.photo}
  jsonLd={personSchema}
>
  <div class="author-page">
    <div class="container">
      <!-- Profil auteur -->
      <div class="author-profile">
        <img
          src={author.photo}
          alt={author.photoAlt ?? `Photo de ${author.name}`}
          width="120"
          height="120"
          loading="eager"
          decoding="async"
          class="author-avatar"
          onerror="this.src='/images/authors/placeholder.svg'"
        />
        <div class="author-details">
          <h1 class="author-name">{author.name}</h1>
          <p class="author-bio">{author.bio}</p>
          {author.expertise.length > 0 && (
            <ul class="author-tags" aria-label="Domaines d'expertise">
              {author.expertise.map((exp) => (
                <li>{exp}</li>
              ))}
            </ul>
          )}
          <div class="author-links">
            {author.website && (
              <a
                href={author.website}
                class="author-social"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Site web de ${author.name}`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Site web
              </a>
            )}
            {author.linkedin && (
              <a
                href={author.linkedin}
                class="author-social author-social--linkedin"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Profil LinkedIn de ${author.name}`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Articles de l'auteur -->
      <section class="author-articles" aria-label={`Articles de ${author.name}`}>
        <h2 class="articles-title">
          {articles.length} article{articles.length > 1 ? 's' : ''} de {author.name}
        </h2>
        {articles.length === 0 ? (
          <p class="no-articles">Aucun article publié pour le moment.</p>
        ) : (
          <div class="articles-grid">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .author-page {
    padding: 3rem 0 5rem;
  }

  .author-profile {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 600px) {
    .author-profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .author-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-accent);
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }

  .author-bio {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 60ch;
  }

  .author-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .author-tags li {
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .author-social {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .author-social:hover {
    text-decoration: underline;
  }

  .author-social--linkedin {
    color: #0a66c2;
  }

  .author-articles {
    margin-top: 1rem;
  }

  .articles-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
  }

  .no-articles {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
