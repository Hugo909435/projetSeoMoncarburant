---
// Page auteur avec schema.org Person
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.data.slug },
    props: { author: author.data },
  }));
}

interface AuthorData {
  name: string;
  slug: string;
  bio: string;
  photo: string;
  photoAlt?: string;
  expertise: string[];
  email?: string;
  linkedin?: string;
}

interface Props {
  author: AuthorData;
}

const { author } = Astro.props;

const articles = await getCollection('blog', ({ data }) => !data.draft && data.author === author.slug);
articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageUrl = `https://mon-carburant.com/auteur/${author.slug}/`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  description: author.bio,
  url: pageUrl,
  image: author.photo.startsWith('http') ? author.photo : `https://mon-carburant.com${author.photo}`,
  knowsAbout: author.expertise,
  worksFor: {
    '@type': 'Organization',
    name: 'Mon Carburant',
    url: 'https://mon-carburant.com',
  },
};
---

<BaseLayout
  title={`${author.name} — Auteur sur Mon Carburant`}
  description={`${author.bio.slice(0, 150)}…`}
  canonical={pageUrl}
  image={author.photo}
  jsonLd={personSchema}
>
  <div class="author-page">
    <div class="container">
      <!-- Profil auteur -->
      <div class="author-profile">
        <img
          src={author.photo}
          alt={author.photoAlt ?? `Photo de ${author.name}`}
          width="120"
          height="120"
          loading="eager"
          decoding="async"
          class="author-avatar"
          onerror="this.src='/images/authors/placeholder.svg'"
        />
        <div class="author-details">
          <h1 class="author-name">{author.name}</h1>
          <p class="author-bio">{author.bio}</p>
          {author.expertise.length > 0 && (
            <ul class="author-tags" aria-label="Domaines d'expertise">
              {author.expertise.map((exp) => (
                <li>{exp}</li>
              ))}
            </ul>
          )}
          {author.linkedin && (
            <a
              href={author.linkedin}
              class="author-social"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Profil LinkedIn de ${author.name}`}
            >
              LinkedIn →
            </a>
          )}
        </div>
      </div>

      <!-- Articles de l'auteur -->
      <section class="author-articles" aria-label={`Articles de ${author.name}`}>
        <h2 class="articles-title">
          {articles.length} article{articles.length > 1 ? 's' : ''} de {author.name}
        </h2>
        {articles.length === 0 ? (
          <p class="no-articles">Aucun article publié pour le moment.</p>
        ) : (
          <div class="articles-grid">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .author-page {
    padding: 3rem 0 5rem;
  }

  .author-profile {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 600px) {
    .author-profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .author-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-accent);
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }

  .author-bio {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 60ch;
  }

  .author-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .author-tags li {
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .author-social {
    align-self: flex-start;
    font-size: 0.9375rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .author-articles {
    margin-top: 1rem;
  }

  .articles-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
  }

  .no-articles {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
