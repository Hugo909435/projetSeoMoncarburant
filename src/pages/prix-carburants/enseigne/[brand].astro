---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandLogo from '../../../components/BrandLogo.astro';
import StationLink from '../../../components/StationLink.astro';
import localPriorities from '../../../data/seo-local-priorities.json';
import statsNational from '../../../data/fuel/stats-national.json';
import brandsIndex from '../../../data/fuel/brands.json';
import departmentsData from '../../../data/departments.json';
import meta from '../../../data/fuel/meta.json';
import { formatMaj } from '../../../utils/format-maj';
import AdUnit from '../../../components/AdUnit.astro';
import FAQ from '../../../components/FAQ.astro';
import { stationUrl } from '../../../utils/station-waves';
import { comparablePrice, fuelDeclaration, hasRecentDeclaration, parisDay, rankComparableStations } from '../../../utils/fuel-comparison.mjs';

export async function getStaticPaths() {
  const brandFiles = import.meta.glob('../../../data/fuel/stations-by-brand/*.json', { eager: true });
  const entries = Object.entries(brandFiles)
    .map(([path, data]: [string, any]) => ({ slug: path.match(/\/([^/]+)\.json$/)?.[1], data }))
    .filter(e => e.slug);

  // Classement des enseignes sur le prix moyen du gazole. Une moyenne sur une
  // poignée de stations ne dit rien de l'enseigne : on ne classe que celles qui
  // ont au moins rankMin stations avec un prix. « independent » regroupe des
  // stations sans enseigne, ce n'est pas une enseigne à classer.
  const rankMin = 20;
  const ranking = entries
    .filter(e => e.slug !== 'independent' && (e.data.stats?.Gazole?.count ?? 0) >= rankMin)
    .map(e => ({
      slug: e.slug as string,
      name: e.data.name as string,
      gazole: e.data.stats.Gazole.avg as number,
      e10: (e.data.stats?.E10?.count ?? 0) >= rankMin ? (e.data.stats.E10.avg as number) : null,
    }))
    .sort((a, b) => a.gazole - b.gazole);

  const cities = Object.values(import.meta.glob('../../../data/fuel/stations-by-city/*.json', { eager: true })) as any[];
  return entries.map(e => {
    const localCities = cities.filter(city => city.count >= 3 && city.stations.some((s: any) => s.enseigneSlug === e.slug))
      .map(city => ({ slug: city.citySlug, name: city.cityName, count: city.stations.filter((s: any) => s.enseigneSlug === e.slug).length }))
      .sort((a, b) => {
        const priority = (slug: string) => { const i = localPriorities.cities.indexOf(slug); return i < 0 ? 999 : i; };
        return priority(a.slug) - priority(b.slug) || b.count - a.count || a.name.localeCompare(b.name, 'fr');
      }).slice(0, 8);
    return { params: { brand: e.slug }, props: { brandData: e.data, ranking, rankMin, localCities } };
  });
}

const { brandData, ranking, rankMin, localCities } = Astro.props;
const { slug, name, stats, top10, count, departments: deptNums } = brandData;

const FUELS = ['Gazole', 'SP95', 'SP98', 'E10', 'E85', 'GPLc'] as const;
const FUEL_COLORS: Record<string, string> = {
  Gazole: '#374151', SP95: '#16a34a', SP98: '#2563eb', E10: '#15803d', E85: '#E87722', GPLc: '#ca8a04',
};
const FUEL_LABELS: Record<string, string> = {
  Gazole: 'Gazole', SP95: 'SP95', SP98: 'SP98', E10: 'E10', E85: 'E85', GPLc: 'GPL',
};

const deps = departmentsData as Record<string, { num: string; name: string; slug: string }>;

function priceDiff(avg: number | null, fuelKey: string) {
  const nat = statsNational[fuelKey as keyof typeof statsNational];
  if (avg == null || nat == null) return null;
  return ((avg - nat) / nat) * 100;
}

function diffClass(diff: number | null) {
  if (diff == null) return 'badge-neutral';
  if (diff < -2) return 'badge-green';
  if (diff > 2) return 'badge-orange';
  return 'badge-neutral';
}

const lastUpdate = meta.lastUpdate
  ? new Date(meta.lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' })
  : null;
const lastUpdateTime = meta.lastUpdate
  ? new Date(meta.lastUpdate).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }).replace(':', 'h')
  : null;

// Prix Gazole moyen de l'enseigne pour le titre/description
const gazoleAvg = stats.Gazole?.avg;
const gazoleNat = statsNational['Gazole'];
const gazolediff = gazoleAvg && gazoleNat ? ((gazoleAvg - gazoleNat) / gazoleNat * 100) : null;
// En dessous de 1 % d'écart, l'enseigne est dans la moyenne : annoncer
// « 0.1% moins cher » serait vrai sur le papier et trompeur à la pompe.
const gazolediffStr = gazolediff == null
  ? ''
  : gazolediff <= -1
    ? `${Math.abs(gazolediff).toFixed(1)}% sous la moyenne nationale`
    : gazolediff >= 1
      ? `${gazolediff.toFixed(1)}% au-dessus de la moyenne nationale`
      : 'dans la moyenne nationale';

// Écart sur un plein de 50 L de gazole par rapport à la moyenne nationale.
const PLEIN_LITRES = 50;
const euros = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
function pleinEcart(avg: number | null | undefined): string {
  if (avg == null || gazoleNat == null) return '-';
  const ecart = (avg - gazoleNat) * PLEIN_LITRES;
  if (Math.abs(ecart) < 0.05) return '0,00 €';
  return `${ecart < 0 ? '-' : '+'}${euros(Math.abs(ecart))} €`;
}
const gazolePlein = gazoleAvg && gazoleNat ? (gazoleAvg - gazoleNat) * PLEIN_LITRES : null;
// Pas de chiffrage en euros quand l'enseigne est annoncée « dans la moyenne ».
const showPlein = gazolePlein != null && gazolediff != null && Math.abs(gazolediff) >= 1;

// Rang de l'enseigne dans le classement gazole (absent si trop peu de stations).
const ordinal = (n: number) => (n === 1 ? '1re' : `${n}e`);
const rankIndex = ranking.findIndex((r: { slug: string }) => r.slug === slug);
const gazoleRank = rankIndex >= 0 ? rankIndex + 1 : null;

// Stations triées du carburant choisi le moins cher au plus cher. Celles qui ne déclarent
// pas de gazole suivent, triées sur l'E10, puis celles sans aucun prix.
const referenceDay = parisDay();
const initialFuel = FUELS.find(fuel => rankComparableStations(brandData.stations, fuel, referenceDay).length > 0) ?? 'Gazole';
const initialStations = rankComparableStations(brandData.stations, initialFuel, referenceDay);
const freshTop10 = Object.fromEntries(['Gazole', 'SP95'].map(fuel => [fuel, rankComparableStations(brandData.stations, fuel, referenceDay).slice(0, 10)]));
const NO_PRICE = 99;
const sortedStations = [...brandData.stations].sort((a: any, b: any) =>
  (a.prices?.Gazole ?? NO_PRICE) - (b.prices?.Gazole ?? NO_PRICE)
  || (a.prices?.E10 ?? NO_PRICE) - (b.prices?.E10 ?? NO_PRICE)
  || String(a.ville ?? '').localeCompare(String(b.ville ?? ''), 'fr'));
const FIRST_ROWS = 60;

const title = `Prix carburant ${name} : gasoil et essence aujourd'hui`;
const descPrix = gazoleAvg ? `Gazole moyen à ${gazoleAvg.toFixed(3).replace('.', ',')} €/L. ` : '';
const description = `${name} : ${descPrix}Comparez le gasoil et l'essence par station. Cherchez votre ville ou code postal et vérifiez la date des prix.`;
const showNovemberContext = meta.lastUpdate
  && meta.lastUpdate.slice(0, 10) >= '2026-11-01' && meta.lastUpdate.slice(0, 10) < '2027-02-01';

// Top 3 enseignes pour la navigation croisée (exclure l'enseigne courante)
const siblingBrands = (brandsIndex as { slug: string; name: string; count: number }[])
  .filter(b => b.slug !== slug)
  .slice(0, 6);

// Départements couverts avec leurs noms
const deptsCovered = (deptNums as string[])
  .map(num => deps[num])
  .filter(Boolean)
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));

// Données de la recherche de stations, lues par le script client. Tableaux
// plutôt qu'objets : sur 1 000 stations et plus, les noms de clés répétés
// pèsent plus lourd que les données. Ordre des colonnes : voir le script.
const stationsData = JSON.stringify({
  referenceDay,
  rows: sortedStations.map((s: any) => [
    s.adresse ?? '', s.ville ?? '', s.cp ?? '', s.dep ?? '',
    comparablePrice(s, 'Gazole'), comparablePrice(s, 'SP95'), comparablePrice(s, 'E10'),
    comparablePrice(s, 'SP98'), comparablePrice(s, 'E85'),
    s.maj ?? '', stationUrl(s.id) ?? '', comparablePrice(s, 'GPLc'), s.priceUpdates ?? null,
  ]),
  deps: Object.fromEntries(deptsCovered.map(d => [d.num, d.slug])),
}).replace(/</g, '\\u003c');

// Enseignes dont les opérations à prix coûtant sont suivies sur la page pilier.
const PRIX_COUTANT_BRANDS = ['leclerc', 'intermarche', 'carrefour', 'super-u', 'total'];

const essenceParts = ([['E10', 'SP95-E10'], ['SP95', 'SP95'], ['SP98', 'SP98']] as const)
  .filter(([k]) => stats[k]?.avg != null)
  .map(([k, label]) => `${label} à ${stats[k].avg.toFixed(3)} €/L`);

const faqItems = [
  gazoleAvg && {
    question: `Quel est le prix du gasoil chez ${name} aujourd'hui ?`,
    answer: `Au ${lastUpdate} à ${lastUpdateTime}, le gasoil (gazole) coûte en moyenne ${gazoleAvg.toFixed(3)} €/L dans les ${stats.Gazole.count} stations ${name} qui déclarent un prix. Selon la station, il va de ${stats.Gazole.min.toFixed(3)} à ${stats.Gazole.max.toFixed(3)} €/L.`,
  },
  essenceParts.length > 0 && {
    question: `Quel est le prix de l'essence chez ${name} ?`,
    answer: `Prix moyens relevés dans les stations ${name} au ${lastUpdate} : ${essenceParts.join(', ')}.`,
  },
  gazoleRank && gazoleAvg && {
    question: `Les stations ${name} sont-elles moins chères que les autres enseignes ?`,
    answer: `Sur le prix moyen du gazole, ${name} se classe ${ordinal(gazoleRank)} sur ${ranking.length} enseignes, de la moins chère à la plus chère (enseignes d'au moins ${rankMin} stations), avec un prix ${gazolediffStr}. C'est une moyenne nationale : d'une ville à l'autre, l'ordre des enseignes peut changer.`,
  },
  {
    question: `Comment trouver la station ${name} la moins chère près de chez moi ?`,
    answer: `Saisissez votre ville, votre code postal ou votre numéro de département dans la recherche de cette page. Les stations ${name} correspondantes s'affichent du carburant choisi le moins cher au plus cher, avec la date de la dernière déclaration de prix.`,
  },
].filter(Boolean) as { question: string; answer: string }[];

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix carburants', url: '/prix-carburants/' },
  { name: `Stations ${name}`, url: `/prix-carburants/enseigne/${slug}/` },
];

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: `https://mon-carburant.com${item.url}`,
  })),
};
---

<BaseLayout title={title} description={description} canonical={`/prix-carburants/enseigne/${slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} slot="head" />

  <div>
    <!-- Breadcrumb -->
    <div class="container" style="padding-top:1rem">
      <nav aria-label="Fil d'ariane" class="breadcrumb-nav">
        {breadcrumb.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> › </span>}
            {i < breadcrumb.length - 1
              ? <a href={item.url}>{item.name}</a>
              : <span aria-current="page">{item.name}</span>
            }
          </>
        ))}
      </nav>
    </div>

    <!-- Hero -->
    <section class="brand-hero">
      <div class="container">
        <div class="brand-hero-top">
          <BrandLogo slug={slug} name={name} />
        </div>
        <h1>Prix carburant {name} aujourd'hui en France</h1>
        <p class="brand-subtitle">{count} stations référencées · {deptsCovered.length} départements</p>
        {lastUpdate && <p class="update-info">Prix relevés le {lastUpdate} à {lastUpdateTime}</p>}
      </div>
    </section>

    <div class="container page-body">

      <!-- Toutes les stations : recherche + 30 premières, le reste via le script -->
      <section class="section-block" id="stations">
        <h2>Comparez les stations {name} près de chez vous</h2>
        <div class="brand-search">
          <label for="brand-search-input">Trouver une station {name} près de chez vous</label>
          <div class="brand-controls">
          <div class="brand-place-field">
          <input
            type="search"
            id="brand-search-input"
            data-brand={name}
            placeholder="Ville, code postal ou département"
            autocomplete="off"
            aria-controls="brand-stations-table"
          />
          </div>
          <div class="brand-fuel-field" data-brand-interactive hidden>
            <label for="brand-fuel">Votre carburant</label>
            <select id="brand-fuel" aria-controls="brand-stations-table">
              {FUELS.map(fuel => <option value={fuel} selected={fuel === initialFuel}>{FUEL_LABELS[fuel]}</option>)}
            </select>
          </div>
          </div>
          <label class="brand-recency" data-brand-interactive hidden>
            <input type="checkbox" id="brand-recent" checked aria-controls="brand-stations-table" />
            Déclarations de 7 jours maximum
          </label>
          <p class="brand-date-note">Hors ruptures signalées. Quand la date du carburant manque, la date affichée est la dernière déclaration de la station, qui peut concerner un autre carburant.</p>
          <p id="brand-search-status" class="brand-search-status" aria-live="polite">
            {initialStations.length} stations avec un prix de {FUEL_LABELS[initialFuel]} et une déclaration de 7 jours maximum, triées par prix croissant.
          </p>
        </div>
        <div class="table-wrapper">
          <table class="stations-table full-table" id="brand-stations-table">
            <thead>
              <tr>
                <th>Adresse</th>
                <th>Ville</th>
                <th>Dept</th>
                <th>Gazole</th>
                <th>SP95</th>
                <th>E10</th>
                <th>SP98</th>
                <th>E85</th>
                <th>GPL</th>
                <th title="Date de la dernière déclaration de prix par la station">Déclaré</th>
              </tr>
            </thead>
            <tbody>
              {initialStations.slice(0, FIRST_ROWS).map((s: any) => (
                <tr>
                  <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                  <td>{s.ville}</td>
                  <td>
                    <a href={`/prix-carburants/${deps[s.dep]?.slug ?? s.dep}/`} class="dept-pill-link">
                      {s.dep}
                    </a>
                  </td>
                  <td>{s.prices.Gazole?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.SP95?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.E10?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.SP98?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.E85?.toFixed(3) ?? '-'}</td>
                  <td>{comparablePrice(s, 'GPLc')?.toFixed(3) ?? '-'}</td>
                  <td class="station-maj" title={fuelDeclaration(s, initialFuel) ?? ''}>{formatMaj(fuelDeclaration(s, initialFuel))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {initialStations.length > FIRST_ROWS && (
          <div style="text-align:center;margin-top:1rem">
            <button id="brand-show-more" class="btn-show-more" type="button">
              Afficher les {initialStations.length - FIRST_ROWS} stations restantes ↓
            </button>
          </div>
        )}
        <script type="application/json" id="brand-stations-data" set:html={stationsData} />
      </section>


      {localCities.length > 0 && (
        <nav class="section-block" aria-label={`Comparer ${name} avec les stations locales`}>
          <h2>Comparer {name} avec les autres stations de votre ville</h2>
          <p class="dept-intro">Ces pages comparent toutes les enseignes de la ville, avec les prix déclarés et les itinéraires.</p>
          <div class="dept-grid">
            {localCities.map((city: { slug: string; name: string }) => <a class="dept-pill" href={`/prix-carburants/ville/${city.slug}/`}>{city.name}</a>)}
          </div>
        </nav>
      )}

      <!-- Stats par carburant -->
      <section class="section-block">
        <h2>Prix moyens {name} en France</h2>
        <div class="fuel-stats-grid">
          {FUELS.map(fuel => {
            const s = stats[fuel];
            const avg = s?.avg ?? null;
            const diff = priceDiff(avg, fuel);
            return (
              <div class="fuel-stat-card" style={`--fuel-color: ${FUEL_COLORS[fuel]}`}>
                <div class="fsc-label">{FUEL_LABELS[fuel]}</div>
                <div class="fsc-price">
                  {avg != null ? avg.toFixed(3) : '-'}
                  {avg != null && <span class="fsc-unit">€/L</span>}
                </div>
                {diff != null && (
                  <div class={`fsc-diff ${diffClass(diff)}`}>
                    {diff > 0 ? '+' : ''}{diff.toFixed(1)}% vs. France
                  </div>
                )}
                {s?.min != null && s?.max != null && (
                  <div class="fsc-range">{s.min.toFixed(3)} - {s.max.toFixed(3)}</div>
                )}
              </div>
            );
          })}
        </div>
        {gazolediff != null && gazolediff < -1 && (
          <p class="brand-insight">
            Les stations {name} affichent un Gazole en moyenne{' '}
            <strong>{Math.abs(gazolediff).toFixed(1)}% moins cher</strong> que la moyenne nationale
            ({gazoleAvg?.toFixed(3)} €/L vs {gazoleNat?.toFixed(3)} €/L).
          </p>
        )}
      </section>

      {showNovemberContext && PRIX_COUTANT_BRANDS.includes(slug) && (
        <section class="section-block seo-text" aria-labelledby="november-brand-title">
          <h2 id="november-brand-title">La baisse du gazole en novembre chez {name}</h2>
          <p>
            La moyenne du réseau ne donne pas le prix de votre station. Comparez les prix de votre secteur
            dans le comparateur en haut de page et vérifiez leur date de déclaration. Notre{' '}
            <a href="/blog/baisse-gazole-1er-novembre-stocks-strategiques/">bilan de la baisse du gazole depuis le 1er novembre</a>{' '}
            explique la mesure et chiffre l'évolution nationale. Pour la tendance du jour, consultez les{' '}
            <a href="/prix-moyen-carburant-france/">prix moyens en France</a>.
          </p>
        </section>
      )}


      <AdUnit />

      <!-- Classement des enseignes sur le gazole -->
      {ranking.length > 1 && (
        <section class="section-block" id="classement">
          <h2>{name} face aux autres enseignes</h2>
          {gazoleRank ? (
            <p class="rank-intro">
              Sur le prix moyen du gazole, {name} se classe <strong>{ordinal(gazoleRank)} sur {ranking.length} enseignes</strong>,
              de la moins chère à la plus chère{showPlein && gazolePlein != null && (
                <>, soit {euros(Math.abs(gazolePlein))} € de {gazolePlein < 0 ? 'moins' : 'plus'} que la moyenne
                nationale sur un plein de {PLEIN_LITRES} litres</>
              )}.
            </p>
          ) : (
            <p class="rank-intro">
              Classement des enseignes d'au moins {rankMin} stations avec un prix gazole, de la moins chère
              à la plus chère.
            </p>
          )}
          <div class="table-wrapper">
            <table class="stations-table rank-table">
              <thead>
                <tr>
                  <th>Rang</th>
                  <th>Enseigne</th>
                  <th>Gazole (€/L)</th>
                  <th>E10 (€/L)</th>
                  <th>Écart sur un plein de {PLEIN_LITRES} L</th>
                </tr>
              </thead>
              <tbody>
                {ranking.map((r: any, i: number) => (
                  <tr class={r.slug === slug ? 'is-current' : undefined}>
                    <td>{i + 1}</td>
                    <td>
                      {r.slug === slug
                        ? <span>{r.name}</span>
                        : <a href={`/prix-carburants/enseigne/${r.slug}/`} class="dept-link">{r.name}</a>}
                    </td>
                    <td>{r.gazole.toFixed(3)}</td>
                    <td>{r.e10 != null ? r.e10.toFixed(3) : '-'}</td>
                    <td class="rank-plein">{pleinEcart(r.gazole)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="rank-note">
            Moyenne des prix déclarés par les stations de chaque enseigne au {lastUpdate}, pour les enseignes
            d'au moins {rankMin} stations avec un prix. L'écart sur un plein compare le gazole de l'enseigne
            à la moyenne nationale ({gazoleNat?.toFixed(3)} €/L).
          </p>
        </section>
      )}

      <!-- Top 10 moins chères -->
      {(freshTop10.Gazole?.length > 0 || freshTop10.SP95?.length > 0) && (
        <section class="section-block">
          <h2>Prix bas {name} : déclarations récentes</h2>
          <div class="top10-tabs">
            {freshTop10.Gazole?.length > 0 && (
              <div class="top10-group">
                <h3 class="top10-title" style="color:#374151">Gazole</h3>
                <table class="stations-table">
                  <thead>
                    <tr><th>Station</th><th>Ville</th><th>Prix Gazole</th><th>Déclaration</th></tr>
                  </thead>
                  <tbody>
                    {freshTop10.Gazole.map((s: any) => (
                      <tr>
                        <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                        <td><a href={`/prix-carburants/${deps[s.dep]?.slug ?? s.dep}/`} class="dept-link">{s.ville}</a></td>
                        <td class="price-highlight">{s.prices.Gazole?.toFixed(3) ?? '-'} €/L</td>
                        <td>{formatMaj(fuelDeclaration(s, 'Gazole'))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {freshTop10.SP95?.length > 0 && (
              <div class="top10-group">
                <h3 class="top10-title" style="color:#16a34a">Sans-Plomb 95</h3>
                <table class="stations-table">
                  <thead>
                    <tr><th>Station</th><th>Ville</th><th>Prix SP95</th><th>Déclaration</th></tr>
                  </thead>
                  <tbody>
                    {freshTop10.SP95.map((s: any) => (
                      <tr>
                        <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                        <td><a href={`/prix-carburants/${deps[s.dep]?.slug ?? s.dep}/`} class="dept-link">{s.ville}</a></td>
                        <td class="price-highlight">{s.prices.SP95?.toFixed(3) ?? '-'} €/L</td>
                        <td>{formatMaj(fuelDeclaration(s, 'SP95'))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Départements couverts -->
      {deptsCovered.length > 0 && (
        <section class="section-block">
          <h2>Stations {name} par département</h2>
          <p class="dept-intro">Cliquez sur un département pour voir tous les prix de carburant dans votre zone.</p>
          <div class="dept-grid">
            {deptsCovered.map(dept => (
              <a href={`/prix-carburants/${dept.slug}/`} class="dept-pill">
                <span class="dept-pill-num">{dept.num}</span>
                <span class="dept-pill-name">{dept.name}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Autres enseignes -->
      {siblingBrands.length > 0 && (
        <section class="section-block">
          <h2>Comparer avec d'autres enseignes</h2>
          <div class="brand-grid">
            {siblingBrands.map(b => (
              <a href={`/prix-carburants/enseigne/${b.slug}/`} class="brand-card">
                <BrandLogo slug={b.slug} name={b.name} />
                <span class="brand-card-name">{b.name}</span>
                <span class="brand-card-count">{b.count} stations</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Texte SEO -->
      <section class="section-block seo-text">
        <h2>Prix du gasoil et de l'essence chez {name} aujourd'hui</h2>
        <p>
          Mon Carburant suit les prix de <strong>{count} stations {name}</strong> réparties dans{' '}
          {deptsCovered.length} départements. Les prix du gasoil (gazole, ou diesel), du sans-plomb et de l'E85
          viennent du flux officiel du ministère de l'Économie, que chaque station est tenue d'alimenter
          quand elle change ses tarifs. Cette page est actualisée plusieurs fois par jour.
        </p>
        {gazoleAvg && (
          <p>
            Au {lastUpdate}, le litre de gasoil coûte en moyenne{' '}
            <strong>{gazoleAvg.toFixed(3)} €/L</strong> chez {name}, un prix {gazolediffStr}{showPlein && gazolePlein != null && (
              <> : sur un plein de {PLEIN_LITRES} litres, cela fait {euros(Math.abs(gazolePlein))} € de{' '}
              {gazolePlein < 0 ? 'moins' : 'plus'}</>
            )}.
            Selon la station, le gazole va de {stats.Gazole?.min.toFixed(3)} à {stats.Gazole?.max.toFixed(3)} €/L.
          </p>
        )}
        <p>
          Pour connaître le prix du diesel ou de l'essence dans la station {name} la plus proche, utilisez la{' '}
          <a href="#stations">recherche par ville ou code postal</a> de cette page. Pour comparer avec toutes
          les stations autour de vous, quelle que soit l'enseigne, passez par le{' '}
          <a href="/prix-carburants/">comparateur national</a>.
        </p>
        {PRIX_COUTANT_BRANDS.includes(slug) && (
          <p>
            Les opérations à prix coûtant des stations {name} sont suivies dans notre{' '}
            <a href="/prix-coutant-carburant/">calendrier du carburant à prix coûtant</a>.
          </p>
        )}
        <p>
          <a href="/prix-carburants/methodologie/">En savoir plus sur notre méthodologie</a>
        </p>
      </section>

      <FAQ items={faqItems} />

    </div>
  </div>
</BaseLayout>

<script>
  import { formatMaj } from '../../../utils/format-maj';
  import { escapeHtml } from '../../../utils/escape-html';
  import { hasRecentDeclaration, fuelDeclaration } from '../../../utils/fuel-comparison.mjs';

  // Colonnes de #brand-stations-data, dans l'ordre écrit par le frontmatter.
  const ADRESSE = 0, VILLE = 1, CP = 2, DEP = 3, GAZOLE = 4, SP95 = 5, E10 = 6, SP98 = 7, E85 = 8, MAJ = 9, URL = 10, GPL = 11, DATES = 12;
  type Row = [string, string, string, string, number | null, number | null, number | null, number | null, number | null, string, string, number | null, Record<string, string> | null];

  const dataEl = document.getElementById('brand-stations-data');
  const tbody = document.querySelector('#brand-stations-table tbody');
  const input = document.getElementById('brand-search-input') as HTMLInputElement | null;
  const status = document.getElementById('brand-search-status');
  const btn = document.getElementById('brand-show-more');
  const fuelSelect = document.getElementById('brand-fuel') as HTMLSelectElement | null;
  const recentOnly = document.getElementById('brand-recent') as HTMLInputElement | null;

  if (dataEl && tbody && input && status && fuelSelect && recentOnly) {
    const { rows, deps, referenceDay } = JSON.parse(dataEl.textContent || '{}') as { rows: Row[]; deps: Record<string, string>; referenceDay: string };
    const fuelColumns: Record<string, number> = { Gazole: GAZOLE, SP95, SP98, E10, E85, GPLc: GPL };
    const declaration = (r: Row) => fuelDeclaration({ maj: r[MAJ], priceUpdates: r[DATES] }, fuelSelect.value);
    const eligibleRows = () => rows.filter(r => typeof r[fuelColumns[fuelSelect.value]] === 'number'
      && (!recentOnly.checked || hasRecentDeclaration({ maj: r[MAJ], priceUpdates: r[DATES] }, fuelSelect.value, referenceDay)))
      .sort((a, b) => Number(a[fuelColumns[fuelSelect.value]]) - Number(b[fuelColumns[fuelSelect.value]]));
    const brand = input.dataset.brand || '';
    const FIRST_ROWS = 60;
    // Au-delà, la liste devient illisible sur mobile : mieux vaut préciser la recherche.
    const MAX_RESULTS = 200;
    let expanded = false;

    // Les villes arrivent en casse et accentuation variables (« CHâTILLON-SUR-SEINE »).
    const norm = (v: string) => v.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

    const price = (v: number | null) => (typeof v === 'number' ? v.toFixed(3) : '-');
    const rowHtml = (r: Row) => {
      const addr = escapeHtml(r[ADRESSE] || '-');
      const depSlug = deps[r[DEP]];
      return `<tr>
        <td class="station-addr">${r[URL] ? `<a href="${escapeHtml(r[URL])}" title="${addr}, ${escapeHtml(r[VILLE])}">${addr}</a>` : addr}</td>
        <td>${escapeHtml(r[VILLE])}</td>
        <td>${depSlug ? `<a href="/prix-carburants/${escapeHtml(depSlug)}/" class="dept-pill-link">${escapeHtml(r[DEP])}</a>` : `<span class="dept-pill-link">${escapeHtml(r[DEP])}</span>`}</td>
        <td>${price(r[GAZOLE])}</td>
        <td>${price(r[SP95])}</td>
        <td>${price(r[E10])}</td>
        <td>${price(r[SP98])}</td>
        <td>${price(r[E85])}</td>
        <td>${price(r[GPL])}</td>
        <td class="station-maj" title="${escapeHtml(declaration(r) || '')}">${formatMaj(declaration(r))}</td>
      </tr>`;
    };
    const render = (list: Row[], limit: number) => {
      tbody.innerHTML = list.slice(0, limit).map(rowHtml).join('');
    };

    const update = () => {
      const q = norm(input.value);
      const eligible = eligibleRows();
      const fuelLabel = fuelSelect.selectedOptions[0].textContent;
      const suffix = recentOnly.checked ? ', déclarations de 7 jours maximum' : ', toutes dates de déclaration';
      if (!q) {
        render(eligible, expanded ? MAX_RESULTS : FIRST_ROWS);
        status.textContent = `${eligible.length} stations avec un prix de ${fuelLabel}${suffix}. Tri par prix croissant.${expanded && eligible.length > MAX_RESULTS ? ' Les 200 premiers résultats sont affichés : précisez une ville.' : ''}`;
        if (btn) { btn.hidden = expanded || eligible.length <= FIRST_ROWS; btn.textContent = `Afficher plus de stations (${eligible.length})`; }
        return;
      }
      const byDep = (dep: string) => eligible.filter(r => r[DEP].toLowerCase() === dep);
      let matches: Row[];
      // Renseigné quand la recherche exacte ne donne rien et qu'on élargit au département.
      let widened = '';
      if (/^\d+$/.test(q)) {
        // 1 ou 2 chiffres : numéro de département. Au-delà : début de code postal.
        matches = q.length <= 2 ? byDep(q.padStart(2, '0')) : eligible.filter(r => r[CP].startsWith(q));
        if (matches.length === 0 && q.length === 5) {
          widened = q.slice(0, 2);
          matches = byDep(widened);
        }
      } else {
        // La ville d'abord : « bordeaux » ne doit pas remonter une « route de Bordeaux » ailleurs.
        matches = eligible.filter(r => norm(r[VILLE]).includes(q) || r[DEP].toLowerCase() === q);
        if (matches.length === 0) matches = eligible.filter(r => norm(r[ADRESSE]).includes(q));
      }
      render(matches, MAX_RESULTS);
      if (btn) btn.hidden = true;
      const n = matches.length;
      const found = `${n} station${n > 1 ? 's' : ''} ${brand} avec un prix de ${fuelLabel}${suffix}`;
      status.textContent = n === 0
        ? `Aucune station avec un prix pour ce carburant et ces filtres trouvée pour « ${input.value.trim()} ».`
        : (widened
          ? `Aucune station ${brand} au code postal ${q}. ${found} dans le département ${widened}, du carburant choisi le moins cher au plus cher`
          : `${found} trouvée${n > 1 ? 's' : ''}, du carburant choisi le moins cher au plus cher`)
          + (n > MAX_RESULTS ? ` (${MAX_RESULTS} premières affichées, précisez la recherche).` : '.');
    };

    input.addEventListener('input', update);
    fuelSelect.addEventListener('change', () => { expanded = false; update(); });
    recentOnly.addEventListener('change', () => { expanded = false; update(); });
    document.querySelectorAll<HTMLElement>('[data-brand-interactive]').forEach(el => { el.hidden = false; });
    update();
    btn?.addEventListener('click', () => {
      expanded = true;
      update();
    });
  }
</script>

