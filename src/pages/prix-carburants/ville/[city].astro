---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CityStationComparator from '../../../components/CityStationComparator.astro';
import departments from '../../../data/departments.json';
import statsNational from '../../../data/fuel/stats-national.json';
import meta from '../../../data/fuel/meta.json';
import { FUEL_COLORS, FUEL_KEYS } from '../../../data/fuel/config';
import { buildCityIntro } from '../../../utils/city-intro';
import { buildCityIdentity } from '../../../utils/city-identity';
import { deptContent } from '../../../data/local-content';
import LocalIdentity from '../../../components/LocalIdentity.astro';
import { existsSync } from 'node:fs';
import AdUnit from '../../../components/AdUnit.astro';
import FAQ from '../../../components/FAQ.astro';
import { comparablePrice, parisDay, rankComparableStations } from '../../../utils/fuel-comparison.mjs';

export async function getStaticPaths() {
  const cityFiles = import.meta.glob('../../../data/fuel/stations-by-city/*.json', { eager: true });
  const deps = departments as Record<string, { num: string; name: string; slug: string; region: string; regionSlug: string }>;

  const cityEntries = Object.values(cityFiles) as any[];
  return Object.entries(cityFiles).map(([path, data]: [string, any]) => {
    const slug = path.match(/\/([^/]+)\.json$/)?.[1];
    if (!slug || !data || !data.stations || data.stations.length === 0) return null;

    const dept = deps[data.department];
    return {
      params: { city: slug },
      props: { cityData: data, dept, nearbyCities: cityEntries
        .filter(city => city.citySlug !== data.citySlug && city.department === data.department && city.count >= 3)
        .sort((a, b) => b.count - a.count).slice(0, 6)
        .map(city => ({ name: city.cityName, slug: city.citySlug })) },
    };
  }).filter(Boolean);
}

const { cityData, dept, nearbyCities } = Astro.props;
const { cityName, citySlug, stats, stations, count } = cityData;

function priceDiff(price: number | null | undefined, fuelKey: string) {
  const nat = statsNational[fuelKey as keyof typeof statsNational];
  if (price == null || nat == null) return null;
  return ((price - nat) / nat) * 100;
}

const lastUpdate = meta.lastUpdate
  ? new Date(meta.lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' })
  : null;

const localTitle = `Carburant à ${cityName} : les stations les moins chères`;
const title = localTitle.length <= 60 ? localTitle : `Prix carburant à ${cityName}`;
const recentGazole = rankComparableStations(stations, 'Gazole', parisDay());
const minGazole = recentGazole.length ? comparablePrice(recentGazole[0], 'Gazole') : null;
const priceLead = minGazole != null ? `Gazole dès ${minGazole.toFixed(3).replace('.', ',')} €/L (déclarations récentes). ` : '';
const detailedDescription = `${cityName} : ${priceLead}Comparez ${count} stations, essence et gazole, avec dates des prix et itinéraires.`;
const description = detailedDescription.length <= 160 ? detailedDescription : `Carburant à ${cityName} : comparez ${count} stations, essence et gazole. Dates des prix déclarés, adresses et itinéraires.`;
const localFaq = [
  {
    question: `Où trouver du gazole moins cher à ${cityName} ?`,
    answer: minGazole != null
      ? `Dans les déclarations de 7 jours maximum, le prix le plus bas du gazole est de ${minGazole.toFixed(3).replace('.', ',')} €/L. Le classement en haut de page donne les adresses et les dates. Vérifiez le tarif en station avant de partir.`
      : `Aucun prix du gazole avec une déclaration de 7 jours maximum n'est disponible dans notre classement. Le tableau conserve les autres déclarations avec leur date ; vous pouvez aussi comparer les autres carburants.`,
  },
  {
    question: `Comment comparer l'essence à ${cityName} ?`,
    answer: `Choisissez SP95, SP95-E10 ou SP98 dans le sélecteur du comparateur. Les stations sont alors classées pour ce carburant, avec les déclarations récentes en premier. Vérifiez la compatibilité avec votre véhicule.`,
  },
  {
    question: 'La date affichée garantit-elle le prix du jour ?',
    answer: `Non. La date est celle de la déclaration disponible dans nos données. Quand la date du carburant n'est pas fournie, nous affichons la dernière déclaration de la station, qui peut concerner un autre carburant. Le prix affiché en station reste à vérifier.`,
  },
];

const introSentences = buildCityIntro({
  cityName,
  citySlug,
  stationCount: count,
  stats,
  stations,
  deptName: dept?.name,
  deptNum: dept?.num,
  nationalStats: statsNational as Record<string, number>,
});

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix carburants', url: '/prix-carburants/' },
  { name: cityName, url: `/prix-carburants/ville/${citySlug}/` },
];
if (dept) {
  breadcrumb.splice(2, 0, { name: dept.name, url: `/prix-carburants/${dept.slug}/` });
}

// Bloc identité ville : emblème (blason communal si présent, sinon blason du
// département) + texte géographique factuel généré.
const dc = dept ? deptContent[dept.num] : undefined;
const prefValue = dc?.facts?.find((f) => f.label === 'Préfecture')?.value;
const isPrefecture = !!prefValue && prefValue === cityName;
const hasCityBlason = existsSync(`public/images/flags/cities/${citySlug}.svg`);
const cityIdentity = dept
  ? {
      emblem: hasCityBlason
        ? `/images/flags/cities/${citySlug}.svg`
        : `/images/flags/departments/${dept.num}.svg`,
      emblemType: 'blason' as const,
      emblemCaption: hasCityBlason
        ? `Blason de ${cityName}`
        : `Blason du département : ${dept.name}`,
      ...buildCityIdentity({
        cityName,
        dept,
        isPrefecture,
        stationCount: count,
        deptNickname: dc?.nickname,
        deptAxes: dc?.facts?.find((f) => f.label === 'Grands axes')?.value,
      }),
    }
  : null;

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: `https://mon-carburant.com${item.url}`,
  })),
};

---

<BaseLayout title={title} description={description} canonical={`/prix-carburants/ville/${citySlug}/`} noIndex={count < 3}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} slot="head" />
  <div>
    <!-- Breadcrumb -->
    <div class="container" style="padding-top:1rem">
      <nav aria-label="Fil d'ariane" class="breadcrumb-nav">
        {breadcrumb.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> › </span>}
            {i < breadcrumb.length - 1
              ? <a href={item.url}>{item.name}</a>
              : <span aria-current="page">{item.name}</span>
            }
          </>
        ))}
      </nav>
    </div>

    <!-- Hero -->
    <section class="city-hero">
      <div class="container">
        <h1>Prix des carburants à {cityName}</h1>
        <p class="city-subtitle">
          {count} stations · {dept ? <a href={`/prix-carburants/${dept.slug}/`} class="dept-link">{dept.name}</a> : null}
        </p>
        {lastUpdate && <p class="update-info">Données du {lastUpdate}</p>}
      </div>
    </section>

    <div class="container page-body">
      <CityStationComparator stations={stations} cityName={cityName} />

      <!-- Stats -->
      <section class="section-block">
        <h2>Prix moyens à {cityName}</h2>
        <div class="fuel-stats-grid">
          {FUEL_KEYS.map((fuel) => {
            const avg = stats[fuel] ?? null;
            const diff = priceDiff(avg, fuel);
            return (
              <div class="fuel-stat-card" style={`--fuel-color: ${FUEL_COLORS[fuel]}`}>
                <div class="fsc-label">{fuel === 'GPLc' ? 'GPL' : fuel}</div>
                <div class="fsc-price">
                  {avg != null ? avg.toFixed(3) : '-'}
                  {avg != null && <span class="fsc-unit">€/L</span>}
                </div>
                {diff != null && (
                  <div class={`fsc-diff ${diff < -5 ? 'badge-green' : diff > 5 ? 'badge-orange' : 'badge-neutral'}`}>
                    {diff > 0 ? '+' : ''}{diff.toFixed(1)}% France
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <AdUnit />

      <!-- Identité locale -->
      {cityIdentity && (
        <LocalIdentity
          content={cityIdentity}
          placeName={cityName}
          heading={`${cityName} : repères`}
        />
      )}

      <!-- Liens navigation -->
      <section class="section-block">
        <div class="nav-links">
          {dept && <a href={`/prix-carburants/${dept.slug}/`} class="nav-link">← {dept.name} ({dept.num})</a>}
          <a href="/prix-carburants/" class="nav-link">Comparateur national</a>
        </div>
      </section>

      {nearbyCities.length > 0 && (
        <section class="section-block" aria-labelledby="other-local-cities">
          <h2 id="other-local-cities">Comparer dans les autres villes du département</h2>
          <p class="local-note">Pour comparer si vous vous y rendez déjà. Ces villes ne sont pas nécessairement les plus proches.</p>
          <nav class="nav-links" aria-label="Autres villes du département">
            {nearbyCities.map((city: { name: string; slug: string }) => <a class="nav-link" href={`/prix-carburants/ville/${city.slug}/`}>{city.name}</a>)}
          </nav>
        </section>
      )}
      <FAQ items={localFaq} />
      <p class="local-note">Pour situer les tarifs locaux, consultez le <a href="/prix-moyen-carburant-france/#bilan-hebdomadaire">bilan hebdomadaire des prix en France</a> et notre <a href="/prix-carburants/methodologie/">méthodologie</a>.</p>

      <!-- Texte SEO -->
      <section class="section-block seo-text">
        <h2>Carburant à {cityName} : tout savoir</h2>
        {introSentences.map((sent) => (
          <p>{sent}</p>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .local-note { color:#475569; font-size:.875rem; line-height:1.6; margin-bottom:1rem; }
  .breadcrumb-nav { font-size: 0.875rem; color: var(--color-text-muted); }
  .breadcrumb-nav a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb-nav a:hover { text-decoration: underline; }
  .city-hero { background: var(--color-primary); color: #fff; padding: 2.5rem 0 2rem; }
  .city-hero h1 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: #fff; margin: 0 0 0.5rem; }
  .city-subtitle { color: #94a3b8; margin: 0 0 0.5rem; }
  .dept-link { color: var(--color-accent); text-decoration: none; }
  .dept-link:hover { text-decoration: underline; }
  .update-info { font-size: 0.8125rem; color: #cbd5e1; margin: 0; }
  .page-body { padding-top: 2rem; padding-bottom: 3rem; }
  .section-block { margin-bottom: 3rem; }
  .section-block h2 { font-size: 1.2rem; font-weight: 700; color: var(--color-primary); margin: 0 0 1.25rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; }
  .fuel-stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  @media (min-width: 768px) { .fuel-stats-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .fuel-stat-card { background: #fff; border: 2px solid #e5e7eb; border-top: 3px solid var(--fuel-color); border-radius: 0.5rem; padding: 1rem; }
  .fsc-label { font-size: 0.75rem; color: var(--color-text-muted); font-weight: 700; margin-bottom: 0.25rem; }
  .fsc-price { font-size: 1.25rem; font-weight: 800; color: var(--fuel-color); display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem; }
  .fsc-unit { font-size: 0.7rem; font-weight: 500; color: var(--color-text-muted); }
  .fsc-diff { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 999px; margin-top: 0.25rem; display: inline-block; font-weight: 600; }
  .badge-green { background: #dcfce7; color: #166534; }
  .badge-orange { background: #fff7ed; color: #c2410c; }
  .badge-neutral { background: #f1f5f9; color: #64748b; }
  .nav-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .nav-link {
    background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 0.5rem;
    padding: 0.5rem 1rem; text-decoration: none; color: var(--color-primary); font-size: 0.875rem; font-weight: 600;
    transition: all 0.15s;
  }
  .nav-link:hover { background: var(--color-primary); color: #fff; }
  .seo-text p { color: #374151; line-height: 1.7; margin-bottom: 0.75rem; }
</style>
