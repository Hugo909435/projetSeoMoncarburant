---
import BaseLayout from '../../layouts/BaseLayout.astro';
import departments from '../../data/departments.json';
import statsNational from '../../data/fuel/stats-national.json';
import meta from '../../data/fuel/meta.json';
import { buildDeptIntro } from '../../utils/dept-intro';
import LocalIdentity from '../../components/LocalIdentity.astro';
import { deptContent } from '../../data/local-content';
import BrandLogo from '../../components/BrandLogo.astro';
import { resolveBrandLogo } from '../../utils/brand-logo';
import StationLink from '../../components/StationLink.astro';
import { stationUrl } from '../../utils/station-waves';
import { formatMaj } from '../../utils/format-maj';
import AdUnit from '../../components/AdUnit.astro';

export async function getStaticPaths() {
  const deptFiles = import.meta.glob('../../data/fuel/stations-by-department/*.json', { eager: true });
  const cityFiles = import.meta.glob('../../data/fuel/stations-by-city/*.json', { eager: true });
  const deps = departments as Record<string, { num: string; name: string; slug: string; region: string; regionSlug: string; neighbors: string[] }>;

  const deptCitiesMap: Record<string, { name: string; slug: string }[]> = {};
  for (const [, data] of Object.entries(cityFiles) as [string, any][]) {
    const { citySlug, cityName, department } = data;
    if (!citySlug || !cityName || !department) continue;
    if (!deptCitiesMap[department]) deptCitiesMap[department] = [];
    deptCitiesMap[department].push({ name: cityName, slug: citySlug });
  }
  for (const arr of Object.values(deptCitiesMap)) {
    arr.sort((a, b) => a.name.localeCompare(b.name, 'fr'));
  }

  return Object.entries(deptFiles).map(([path, data]: [string, any]) => {
    const num = path.match(/\/(\w+)\.json$/)?.[1];
    if (!num) return null;
    const dept = deps[num];
    if (!dept) return null;
    return {
      params: { department: dept.slug },
      props: { deptData: data, dept, deptCities: deptCitiesMap[num] ?? [] },
    };
  }).filter(Boolean);
}

const { deptData, dept, deptCities } = Astro.props;
const { stats, stations, top10, count } = deptData;
const localContent = deptContent[dept.num];
const deps = departments as Record<string, { num: string; name: string; slug: string; region: string; regionSlug: string; neighbors: string[] }>;

const FUELS = ['Gazole', 'SP95', 'SP98', 'E10', 'E85', 'GPLc'] as const;
const FUEL_COLORS: Record<string, string> = {
  Gazole: '#374151', SP95: '#16a34a', SP98: '#2563eb', E10: '#15803d', E85: '#E87722', GPLc: '#ca8a04',
};

function priceDiff(price: number | null, fuelKey: string) {
  const nat = statsNational[fuelKey as keyof typeof statsNational];
  if (price == null || nat == null) return null;
  return ((price - nat) / nat) * 100;
}

function diffClass(diff: number | null) {
  if (diff == null) return 'badge-neutral';
  if (diff < -5) return 'badge-green';
  if (diff > 5) return 'badge-orange';
  return 'badge-neutral';
}

const neighborDepts = dept.neighbors
  .map((n: string) => deps[n])
  .filter(Boolean);

const lastUpdate = meta.lastUpdate
  ? new Date(meta.lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const gazoleAvg = stats.Gazole?.avg;

const title = `Prix carburant ${dept.name} (${dept.num}) - Comparateur Mon Carburant`;
const descPrice = gazoleAvg ? `Prix moyen Gazole : ${gazoleAvg.toFixed(3)}€/L.` : '';
const description = `Comparez les prix du carburant dans le ${dept.name} (${dept.num}). ${count} stations référencées. ${descPrice} Mis à jour quotidiennement.`;

const introSentences = buildDeptIntro({
  deptName: dept.name,
  deptNum: dept.num,
  deptRegion: dept.region,
  stationCount: count,
  stats,
  top10Gazole: top10?.Gazole ?? [],
  top10Sp95: top10?.SP95 ?? [],
  nationalStats: statsNational as Record<string, number>,
});

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix carburants', url: '/prix-carburants/' },
  { name: dept.name, url: `/prix-carburants/${dept.slug}/` },
];

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: `https://mon-carburant.com${item.url}`,
  })),
};

// Pilote schema.org GasStation/Offer : limite au departement Mayenne (53) le temps de valider
// l'impact avant un deploiement plus large. Ne couvre que les stations visibles dans le tableau
// (30 premieres) pour rester strictement fidele au contenu affiche.
const FUEL_LABELS: Record<string, string> = {
  Gazole: 'Gazole', SP95: 'Sans-plomb 95', SP98: 'Sans-plomb 98', E10: 'E10', E85: 'E85', GPLc: 'GPL',
};

const jsonLdGasStations = dept.num === '53'
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: stations.slice(0, 30).map((s: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'GasStation',
          name: s.enseigne ? `${s.enseigne} ${s.ville}` : `Station-service ${s.ville}`,
          address: {
            '@type': 'PostalAddress',
            streetAddress: s.adresse || undefined,
            addressLocality: s.ville,
            postalCode: s.cp,
            addressCountry: 'FR',
          },
          geo: (s.lat != null && s.lng != null)
            ? { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng }
            : undefined,
          ...(s.enseigne ? { brand: { '@type': 'Brand', name: s.enseigne } } : {}),
          makesOffer: FUELS.filter(f => s.prices?.[f] != null).map(f => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: FUEL_LABELS[f] },
            price: s.prices[f].toFixed(3),
            priceCurrency: 'EUR',
            availability: 'https://schema.org/InStock',
            ...(s.maj ? { validFrom: s.maj.replace(' ', 'T') } : {}),
          })),
        },
      })),
    }
  : null;
---

<BaseLayout title={title} description={description} canonical={`/prix-carburants/${dept.slug}/`} noIndex={count < 3}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} slot="head" />
  {jsonLdGasStations && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGasStations)} slot="head" />
  )}

  <div>
    <!-- Breadcrumb -->
    <div class="container" style="padding-top:1rem">
      <nav aria-label="Fil d'ariane" class="breadcrumb-nav">
        {breadcrumb.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> › </span>}
            {i < breadcrumb.length - 1
              ? <a href={item.url}>{item.name}</a>
              : <span aria-current="page">{item.name}</span>
            }
          </>
        ))}
      </nav>
    </div>

    <!-- Hero -->
    <section class="dept-hero">
      <div class="container">
        <h1>Prix des carburants en {dept.name} ({dept.num})</h1>
        <p class="dept-subtitle">{count} stations référencées · Région {dept.region}</p>
        {lastUpdate && <p class="update-info">Données du {lastUpdate}</p>}
      </div>
    </section>

    <div class="container page-body">
      <!-- Identité locale -->
      {localContent && (
        <LocalIdentity
          content={localContent}
          placeName={`le ${dept.name}`}
          heading={`Le ${dept.name} (${dept.num})`}
        />
      )}

      <!-- Stats par carburant -->
      <section class="section-block">
        <h2>Prix moyens dans le {dept.name}</h2>
        <div class="fuel-stats-grid">
          {FUELS.map(fuel => {
            const s = stats[fuel];
            const avg = s?.avg ?? null;
            const diff = priceDiff(avg, fuel);
            return (
              <div class="fuel-stat-card" style={`--fuel-color: ${FUEL_COLORS[fuel]}`}>
                <div class="fsc-label">{fuel === 'GPLc' ? 'GPL' : fuel}</div>
                <div class="fsc-price">
                  {avg != null ? avg.toFixed(3) : '-'}
                  {avg != null && <span class="fsc-unit">€/L</span>}
                </div>
                {diff != null && (
                  <div class={`fsc-diff ${diffClass(diff)}`}>
                    {diff > 0 ? '+' : ''}{diff.toFixed(1)}% vs. France
                  </div>
                )}
                {s?.min != null && s?.max != null && (
                  <div class="fsc-range">{s.min.toFixed(3)} - {s.max.toFixed(3)}</div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <!-- Top 10 moins chers -->
      {(top10.Gazole?.length > 0 || top10.SP95?.length > 0) && (
        <section class="section-block">
          <h2>Top 10 stations les moins chères</h2>
          <div class="top10-tabs">
            <div class="top10-group">
              <h3 class="top10-title" style="color: #374151">Gazole</h3>
              {top10.Gazole?.length > 0 ? (
                <table class="stations-table">
                  <thead>
                    <tr><th>Marque</th><th>Station</th><th>Ville</th><th>Prix Gazole</th></tr>
                  </thead>
                  <tbody>
                    {top10.Gazole.map((s: any) => (
                      <tr>
                        <td class="brand-cell">{s.enseigneSlug ? <BrandLogo slug={s.enseigneSlug} name={s.enseigne ?? s.enseigneSlug} /> : <span class="brand-unknown">{s.enseigne ?? '-'}</span>}</td>
                        <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                        <td>{s.ville} ({s.cp})</td>
                        <td class="price-highlight">{s.prices.Gazole?.toFixed(3) ?? '-'} €/L</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : <p class="no-data">Aucune donnée disponible</p>}
            </div>
            <div class="top10-group">
              <h3 class="top10-title" style="color: #16a34a">Sans-Plomb 95</h3>
              {top10.SP95?.length > 0 ? (
                <table class="stations-table">
                  <thead>
                    <tr><th>Marque</th><th>Station</th><th>Ville</th><th>Prix SP95</th></tr>
                  </thead>
                  <tbody>
                    {top10.SP95.map((s: any) => (
                      <tr>
                        <td class="brand-cell">{s.enseigneSlug ? <BrandLogo slug={s.enseigneSlug} name={s.enseigne ?? s.enseigneSlug} /> : <span class="brand-unknown">{s.enseigne ?? '-'}</span>}</td>
                        <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                        <td>{s.ville} ({s.cp})</td>
                        <td class="price-highlight">{s.prices.SP95?.toFixed(3) ?? '-'} €/L</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : <p class="no-data">Aucune donnée disponible</p>}
            </div>
          </div>
        </section>
      )}

      <AdUnit />

      <!-- Toutes les stations -->
      <section class="section-block">
        <h2>Toutes les stations ({count})</h2>
        <div class="table-wrapper">
          <table class="stations-table full-table" id="all-stations-table">
            <thead>
              <tr>
                <th>Marque</th>
                <th>Adresse</th>
                <th>Ville</th>
                <th>Type</th>
                <th>Gazole</th>
                <th>SP95</th>
                <th>SP98</th>
                <th>E10</th>
                <th>E85</th>
                <th>GPL</th>
                <th title="Date de la dernière déclaration de prix par la station">Déclaré</th>
              </tr>
            </thead>
            <tbody>
              {stations.slice(0, 30).map((s: any) => (
                <tr>
                  <td class="brand-cell">{s.enseigneSlug ? <BrandLogo slug={s.enseigneSlug} name={s.enseigne ?? s.enseigneSlug} /> : <span class="brand-unknown">{s.enseigne ?? '-'}</span>}</td>
                  <td class="station-addr"><StationLink id={s.id} adresse={s.adresse} ville={s.ville} /></td>
                  <td>{s.ville} ({s.cp})</td>
                  <td><span class={`pop-badge ${s.pop === 'autoroute' ? 'pop-auto' : 'pop-route'}`}>{s.pop === 'autoroute' ? 'Autoroute' : 'Route'}</span></td>
                  <td>{s.prices.Gazole?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.SP95?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.SP98?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.E10?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.E85?.toFixed(3) ?? '-'}</td>
                  <td>{s.prices.GPLc?.toFixed(3) ?? '-'}</td>
                  <td class="station-maj" title={s.maj ?? ''}>{formatMaj(s.maj)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {count > 30 && (
          <div style="text-align:center; margin-top:1rem">
            <button id="show-more-btn" class="btn-show-more" data-stations={JSON.stringify(stations.slice(30).map((s: any) => ({
              adresse: s.adresse, ville: s.ville, cp: s.cp, pop: s.pop, prices: s.prices, enseigne: s.enseigne, enseigneSlug: s.enseigneSlug, logo: resolveBrandLogo(s.enseigneSlug), maj: s.maj, url: stationUrl(s.id)
            })))}>
              Afficher toutes les {count} stations ↓
            </button>
          </div>
        )}
      </section>

      <!-- Départements limitrophes -->
      {neighborDepts.length > 0 && (
        <section class="section-block">
          <h2>Départements limitrophes</h2>
          <div class="neighbor-grid">
            {neighborDepts.map((n: any) => (
              <a href={`/prix-carburants/${n.slug}/`} class="neighbor-card">
                <strong>{n.num}</strong> - {n.name}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Villes du département -->
      {deptCities.length > 0 && (
        <section class="section-block">
          <h2>Prix carburant par ville en {dept.name}</h2>
          <div class="cities-grid">
            {deptCities.map((city: { name: string; slug: string }) => (
              <a href={`/prix-carburants/ville/${city.slug}/`} class="city-link">
                {city.name}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Texte unique SEO -->
      <section class="section-block seo-text">
        <h2>Carburant {dept.name} : informations pratiques</h2>
        {introSentences.map(sent => (
          <p>{sent}</p>
        ))}
        <p>
          <a href="/prix-carburants/methodologie/">En savoir plus sur notre méthodologie</a> ·
          <a href="/prix-carburants/">Comparateur national</a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { formatMaj } from '../../utils/format-maj';
  import { escapeHtml } from '../../utils/escape-html';

  // Afficher plus de stations
  const btn = document.getElementById('show-more-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      const extraStations = JSON.parse(btn.dataset.stations || '[]');
      const tbody = document.querySelector('#all-stations-table tbody');
      if (!tbody) return;
      extraStations.forEach((s: any) => {
        const tr = document.createElement('tr');
        const brandLabel = escapeHtml(s.enseigne || s.enseigneSlug);
        const brandHtml = s.enseigneSlug && s.logo
          ? `<span class="brand-logo-wrap"><img src="${escapeHtml(s.logo)}" alt="${brandLabel}" class="brand-logo-img" loading="lazy" onerror="this.style.display='none';this.nextSibling.style.display='inline-block'"/><span class="brand-logo-text" style="display:none">${brandLabel}</span></span>`
          : `<span class="brand-unknown">${escapeHtml(s.enseigne || '-')}</span>`;
        tr.innerHTML = `
          <td class="brand-cell">${brandHtml}</td>
          <td class="station-addr">${s.url ? `<a href="${escapeHtml(s.url)}">${escapeHtml(s.adresse || 'Station-service')}</a>` : escapeHtml(s.adresse || '-')}</td>
          <td>${escapeHtml(s.ville)} (${escapeHtml(s.cp)})</td>
          <td><span class="pop-badge ${s.pop === 'autoroute' ? 'pop-auto' : 'pop-route'}">${s.pop === 'autoroute' ? 'Autoroute' : 'Route'}</span></td>
          <td>${s.prices?.Gazole?.toFixed(3) ?? '-'}</td>
          <td>${s.prices?.SP95?.toFixed(3) ?? '-'}</td>
          <td>${s.prices?.SP98?.toFixed(3) ?? '-'}</td>
          <td>${s.prices?.E10?.toFixed(3) ?? '-'}</td>
          <td>${s.prices?.E85?.toFixed(3) ?? '-'}</td>
          <td>${s.prices?.GPLc?.toFixed(3) ?? '-'}</td>
          <td class="station-maj" title="${escapeHtml(s.maj ?? '')}">${formatMaj(s.maj)}</td>
        `;
        tbody.appendChild(tr);
      });
      btn.remove();
    });
  }
</script>

<style>
  .breadcrumb-nav { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .breadcrumb-nav a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb-nav a:hover { text-decoration: underline; }
  .dept-hero { background: var(--color-primary); color: #fff; padding: 2.5rem 0 2rem; }
  .dept-hero h1 { font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 800; color: #fff; margin: 0 0 0.5rem; }
  .dept-subtitle { color: #94a3b8; margin: 0 0 0.5rem; }
  .update-info { font-size: 0.8125rem; color: #64748b; margin: 0; }
  .page-body { padding-top: 2rem; padding-bottom: 3rem; }
  .section-block { margin-bottom: 3rem; }
  .section-block h2 { font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin: 0 0 1.25rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; }
  .fuel-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  @media (min-width: 768px) { .fuel-stats-grid { grid-template-columns: repeat(6, 1fr); } }
  .fuel-stat-card { background: #fff; border: 2px solid #e5e7eb; border-top: 3px solid var(--fuel-color); border-radius: 0.5rem; padding: 1rem; }
  .fsc-label { font-size: 0.75rem; color: var(--color-text-muted); font-weight: 700; margin-bottom: 0.25rem; }
  .fsc-price { font-size: 1.25rem; font-weight: 800; color: var(--fuel-color); display: flex; align-items: baseline; gap: 0.2rem; }
  .fsc-unit { font-size: 0.7rem; font-weight: 500; color: var(--color-text-muted); }
  .fsc-diff { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 999px; margin-top: 0.25rem; display: inline-block; font-weight: 600; }
  .fsc-range { font-size: 0.7rem; color: var(--color-text-muted); margin-top: 0.25rem; }
  .badge-green { background: #dcfce7; color: #166534; }
  .badge-orange { background: #fff7ed; color: #c2410c; }
  .badge-neutral { background: #f1f5f9; color: #64748b; }
  .top10-tabs { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .top10-tabs { grid-template-columns: 1fr 1fr; } }
  .top10-title { font-size: 1rem; font-weight: 700; margin: 0 0 0.75rem; }
  .table-wrapper { overflow-x: auto; }
  .stations-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .stations-table th { background: #f1f5f9; color: var(--color-primary); padding: 0.6rem 0.75rem; text-align: left; font-size: 0.8rem; }
  .stations-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #f1f5f9; }
  .stations-table tr:hover td { background: #f8fafc; }
  .station-addr { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .station-maj { white-space: nowrap; font-size: 0.75rem; color: #64748b; }
  .price-highlight { font-weight: 700; color: #16a34a; }
  .pop-badge { font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600; }
  .pop-auto { background: #fef3c7; color: #92400e; }
  .pop-route { background: #e0f2fe; color: #075985; }
  .brand-cell { white-space: nowrap; padding: 0.4rem 0.75rem; }
  .brand-unknown { font-size: 0.7rem; color: #64748b; background: #f1f5f9; border-radius: 3px; padding: 0.1rem 0.4rem; }
  /* Toute la chaîne de sélecteur doit être dans :global() : les lignes injectées par le bouton
     "Afficher toutes les stations" (script client, innerHTML) n'ont pas l'attribut data-astro-cid
     du style scopé de BrandLogo.astro, ni sur l'image ni sur le <td class="brand-cell"> parent. */
  :global(.brand-cell .brand-logo-wrap) { display: inline-flex; align-items: center; vertical-align: middle; }
  :global(.brand-cell .brand-logo-img) { height: 32px; width: auto; border-radius: 3px; display: block; }
  :global(.brand-cell .brand-logo-text) { font-size: 0.75rem; font-weight: 600; color: var(--color-primary); background: #f1f5f9; border-radius: 3px; padding: 0.1rem 0.4rem; white-space: nowrap; }
  .cities-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .city-link {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.15s;
  }
  .city-link:hover {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }
  .btn-show-more {
    background: #fff; border: 2px solid var(--color-primary); color: var(--color-primary);
    padding: 0.6rem 1.5rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.9rem;
    transition: all 0.2s;
  }
  .btn-show-more:hover { background: var(--color-primary); color: #fff; }
  .neighbor-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .neighbor-card {
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem;
    padding: 0.5rem 1rem; text-decoration: none; color: var(--color-primary); font-size: 0.875rem;
    transition: all 0.15s;
  }
  .neighbor-card:hover { background: var(--color-primary); color: #fff; }
  .seo-text p { color: #374151; line-height: 1.7; margin-bottom: 0.75rem; }
  .seo-text a { color: var(--color-accent); }
  .no-data { color: var(--color-text-muted); font-style: italic; font-size: 0.875rem; }
  .full-table th:last-child, .full-table td:last-child { display: none; }
  @media (min-width: 768px) { .full-table th:last-child, .full-table td:last-child { display: table-cell; } }
</style>
