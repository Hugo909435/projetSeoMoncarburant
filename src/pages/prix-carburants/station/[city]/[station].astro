---
/**
 * Page de détail d'une station-service.
 *
 * Ces pages sont publiées par vagues (voir STATIONS-ROLLOUT.md). getStaticPaths
 * ne génère que les stations dont la vague est échue à la date du build : le
 * reste du parc existe dans les données mais n'est pas rendu, donc pas exposé
 * au sitemap ni au crawl.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BrandLogo from '../../../../components/BrandLogo.astro';
import BrandCell from '../../../../components/BrandCell.astro';
import StationMiniMap from '../../../../components/StationMiniMap.astro';
import departments from '../../../../data/departments.json';
import statsNational from '../../../../data/fuel/stats-national.json';
import statsByDept from '../../../../data/fuel/stats-by-department.json';
import brandsIndex from '../../../../data/fuel/brands.json';
import cityNames from '../../../../data/fuel/city-names.json';
import meta from '../../../../data/fuel/meta.json';
import { FUEL_COLORS, FUEL_KEYS } from '../../../../data/fuel/config';
import { publishedStations, stationUrl } from '../../../../utils/station-waves';
import {
  buildStationIntro,
  buildStationFaq,
  stationHeading,
  stationDisplayName,
  type StationLike,
} from '../../../../utils/station-intro';
import { decodeHoraires, horairesToSchema, isAlwaysOpen } from '../../../../utils/station-hours';
import { formatMaj } from '../../../../utils/format-maj';
import { isWeakStation, weaknessReason } from '../../../../utils/station-quality.mjs';

type Dept = { num: string; name: string; slug: string; region: string; regionSlug: string };

export async function getStaticPaths() {
  // Astro isole getStaticPaths du reste du frontmatter : les helpers dont il a
  // besoin doivent être déclarés à l'intérieur.

  /** Distance à vol d'oiseau en kilomètres. */
  const haversine = (aLat: number, aLng: number, bLat: number, bLng: number): number => {
    const R = 6371;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(bLat - aLat);
    const dLng = toRad(bLng - aLng);
    const h =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  };

  const deptFiles = import.meta.glob('../../../../data/fuel/stations-by-department/*.json', { eager: true });
  const detailFiles = import.meta.glob('../../../../data/fuel/stations-detail/*.json', { eager: true });
  const cityFiles = import.meta.glob('../../../../data/fuel/stations-by-city/*.json', { eager: true });

  const deps = departments as Record<string, Dept>;

  // Le flux gouvernemental écrit un tiers des communes en majuscules et le
  // reste dans des casses mélangées. On affiche partout la graphie normalisée
  // (voir buildCityNames dans scripts/fetch-fuel-data.js).
  const names = cityNames as Record<string, string>;
  const displayCity = (s: any) => names[s.villeSlug] ?? s.ville;

  // Villes et enseignes qui disposent déjà d'une page : on ne crée pas de lien
  // interne vers une URL qui n'existe pas.
  const citySlugsWithPage = new Set(
    Object.keys(cityFiles).map((p) => p.match(/\/([^/]+)\.json$/)?.[1] ?? ''),
  );
  const brandSlugsWithPage = new Set((brandsIndex as { slug: string }[]).map((b) => b.slug));

  // Détail (services, horaires) indexé par identifiant de station.
  const detailById: Record<string, any> = {};
  for (const mod of Object.values(detailFiles) as any[]) {
    Object.assign(detailById, mod.default ?? mod);
  }

  /**
   * Répartition des stations par enseigne sur un périmètre donné.
   *
   * Les stations sans enseigne identifiée (28 % du parc) sont regroupées sur
   * une ligne plutôt qu'ignorées : les passer sous silence donnerait un total
   * qui ne correspond pas au nombre de stations annoncé ailleurs sur la page.
   */
  const buildBrandTable = (list: any[]) => {
    const map = new Map<string, any>();
    for (const s of list) {
      const known = s.enseigneSlug && s.enseigneSlug !== 'independent';
      const key = known ? s.enseigneSlug : '__none__';
      let entry = map.get(key);
      if (!entry) {
        entry = {
          slug: known ? s.enseigneSlug : null,
          name: known ? (s.enseigne ?? s.enseigneSlug) : 'Indépendantes ou non renseignées',
          count: 0,
          prices: [] as number[],
        };
        map.set(key, entry);
      }
      entry.count++;
      if (s.prices?.Gazole != null) entry.prices.push(s.prices.Gazole);
    }

    const rows = [...map.values()]
      .map((e) => ({
        slug: e.slug,
        name: e.name,
        count: e.count,
        avg: e.prices.length > 0 ? e.prices.reduce((a: number, b: number) => a + b, 0) / e.prices.length : null,
        min: e.prices.length > 0 ? Math.min(...e.prices) : null,
      }))
      .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'fr'));

    // Au-delà de dix lignes le tableau cesse d'être « pratique ». Le reste est
    // agrégé pour que la somme reste juste.
    if (rows.length <= 10) return rows;
    const head = rows.slice(0, 9);
    const tail = rows.slice(9);
    head.push({
      slug: null,
      name: `${tail.length} autres enseignes`,
      count: tail.reduce((n, r) => n + r.count, 0),
      avg: null,
      min: null,
    });
    return head;
  };

  const paths: any[] = [];

  for (const [path, mod] of Object.entries(deptFiles) as [string, any][]) {
    const depNum = path.match(/\/([^/]+)\.json$/)?.[1];
    const data = mod.default ?? mod;
    if (!depNum || !data?.stations?.length) continue;

    const dept = deps[depNum];
    if (!dept) continue;

    const all = data.stations as any[];

    // Agrégats par commune, calculés une fois par département. Ils couvrent
    // toutes les communes, y compris celles qui n'ont pas de page ville.
    const byCity = new Map<string, any[]>();
    for (const s of all) {
      const list = byCity.get(s.villeSlug);
      if (list) list.push(s);
      else byCity.set(s.villeSlug, [s]);
    }

    const cityAggregates = new Map<
      string,
      { stats: Record<string, number>; count: number; gazoleOrder: string[]; brands: any[] }
    >();
    for (const [slug, list] of byCity) {
      const stats: Record<string, number> = {};
      for (const fuel of FUEL_KEYS) {
        const values = list.map((s) => s.prices?.[fuel]).filter((v: any) => v != null);
        if (values.length > 0) {
          stats[fuel] = values.reduce((a: number, b: number) => a + b, 0) / values.length;
        }
      }
      const gazoleOrder = list
        .filter((s) => s.prices?.Gazole != null)
        .sort((a, b) => a.prices.Gazole - b.prices.Gazole || a.id.localeCompare(b.id))
        .map((s) => s.id);
      cityAggregates.set(slug, { stats, count: list.length, gazoleOrder, brands: buildBrandTable(list) });
    }

    const deptBrands = buildBrandTable(all);

    for (const station of all) {
      const entry = publishedStations.get(String(station.id));
      if (!entry) continue; // vague pas encore échue

      const slashIndex = entry.path.indexOf('/');
      const citySegment = entry.path.slice(0, slashIndex);
      const stationSegment = entry.path.slice(slashIndex + 1);
      if (!citySegment || !stationSegment) continue;

      const aggregate = cityAggregates.get(station.villeSlug);
      const gazoleOrder = aggregate?.gazoleOrder ?? [];
      const rankIndex = gazoleOrder.indexOf(String(station.id));

      // Cinq stations les plus proches du même département. Le maillage se
      // densifie à mesure que les vagues sortent : une voisine non encore
      // publiée est affichée sans lien.
      const nearby = all
        .filter((s) => s.id !== station.id && s.lat && s.lng)
        .map((s) => ({ station: s, distance: haversine(station.lat, station.lng, s.lat, s.lng) }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, 5)
        .map(({ station: s, distance }) => ({
          id: s.id,
          nom: s.enseigne ?? null,
          enseigneSlug: s.enseigneSlug ?? null,
          adresse: s.adresse,
          ville: displayCity(s),
          gazole: s.prices?.Gazole ?? null,
          distance,
          url: stationUrl(s.id),
        }));

      paths.push({
        params: { city: citySegment, station: stationSegment },
        props: {
          station: { ...station, ville: displayCity(station) },
          detail: detailById[String(station.id)] ?? {},
          dept,
          cityStats: aggregate?.stats ?? {},
          cityStationCount: aggregate?.count ?? 1,
          cityRankGazole: rankIndex >= 0 ? rankIndex + 1 : null,
          cityRankTotal: gazoleOrder.length > 0 ? gazoleOrder.length : null,
          deptStationCount: all.length,
          // Sur une commune à une ou deux stations, la répartition par enseigne
          // n'apprend rien : on élargit alors au département.
          brandTable: (aggregate?.count ?? 1) >= 3 ? (aggregate?.brands ?? []) : deptBrands,
          brandTableScope: (aggregate?.count ?? 1) >= 3 ? 'commune' : 'departement',
          cityHasPage: citySlugsWithPage.has(station.villeSlug),
          brandHasPage: !!station.enseigneSlug && brandSlugsWithPage.has(station.enseigneSlug),
          nearby,
          canonicalPath: `/prix-carburants/station/${entry.path}/`,
        },
      });
    }
  }

  return paths;
}

const {
  station,
  detail,
  dept,
  deptStationCount,
  brandTable,
  brandTableScope,
  cityStats,
  cityStationCount,
  cityRankGazole,
  cityRankTotal,
  cityHasPage,
  brandHasPage,
  nearby,
  canonicalPath,
} = Astro.props;

const s = station as StationLike & { lat: number; lng: number; villeSlug: string };
const services: string[] = detail.services ?? [];
const horaires: (string | null)[] | null = detail.horaires ?? null;
const automate: boolean = !!detail.automate;

const national = statsNational as Record<string, number>;
const deptStats = ((statsByDept as Record<string, Record<string, number>>)[dept.num] ?? {}) as Record<string, number>;

const introParams = {
  station: s,
  services,
  horaires,
  automate,
  cityStats,
  cityStationCount,
  cityRankGazole,
  cityRankTotal,
  deptStats,
  deptName: dept.name,
  deptNum: dept.num,
  deptStationCount,
  nationalStats: national,
};

const paragraphs = buildStationIntro(introParams);
const faq = buildStationFaq(introParams);
const weekHours = decodeHoraires(horaires);
const alwaysOpen = isAlwaysOpen(horaires);

// Fiche trop pauvre pour être proposée à l'indexation : pas de prix à comparer,
// adresse inexploitable, ou déclaration trop ancienne. La page reste accessible
// et reliée au site, elle n'est simplement pas offerte au référencement.
const isWeak = isWeakStation(s);
const weakReason = isWeak ? weaknessReason(s) : null;

const heading = stationHeading(s);
const brandName = s.enseigne && s.enseigne !== 'independent' ? s.enseigne : null;

const lastUpdate = meta.lastUpdate
  ? new Date(meta.lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

// ── Métadonnées ───────────────────────────────────────────────────────────────
// metaTitle est plafonné à 60 caractères sur le reste du site. Ici le titre est
// construit, pas rédigé : on dégrade proprement plutôt que de tronquer au milieu
// d'un mot sur les adresses longues.
const gazole = s.prices['Gazole'] ?? null;
const cheapestLabel = cityRankGazole === 1 ? ' - la moins chère' : '';

// Trois formulations par ordre de préférence, de la plus riche à la plus
// courte. On retient la première qui tient dans la limite, et on tronque en
// dernier recours pour les communes à nom très long
// ("Bretteville-l'Orgueilleuse Thue et Mue").
const titleCandidates = [
  `Prix carburant station ${brandName ?? ''} ${s.ville}${cheapestLabel}`,
  `Prix carburant station ${brandName ?? ''} ${s.ville}`,
  `Prix carburant station ${s.ville}`,
  `Carburant ${s.ville}`,
].map((t) => t.replace(/\s+/g, ' ').trim());

const title =
  titleCandidates.find((t) => t.length <= 60) ?? titleCandidates.at(-1)!.slice(0, 60).trimEnd();

// La description est assemblée puis tronquée sur une frontière de phrase :
// une adresse longue ne doit pas produire une coupe au milieu d'un mot.
const descLead = `${stationDisplayName(s)}${s.adresse ? `, ${s.adresse}` : ''} à ${s.ville}`;
const descPrice =
  gazole != null
    ? `Gazole à ${gazole.toFixed(3)} €/L, prix mis à jour chaque jour.`
    : `prix des carburants, horaires et services, mis à jour chaque jour.`;

let description = `${descLead} : ${descPrice}`;
if (description.length > 160) {
  description = `${descLead.slice(0, 160 - descPrice.length - 3).trimEnd()} : ${descPrice}`;
}
if (description.length > 160) {
  description = description.slice(0, 157).trimEnd() + '...';
}

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix carburants', url: '/prix-carburants/' },
  { name: dept.name, url: `/prix-carburants/${dept.slug}/` },
  ...(cityHasPage ? [{ name: s.ville, url: `/prix-carburants/ville/${s.villeSlug}/` }] : []),
  { name: brandName ?? 'Station', url: canonicalPath },
];

const openingHours = horairesToSchema(horaires);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'GasStation',
    '@id': `https://mon-carburant.com${canonicalPath}`,
    name: brandName ? `${brandName} ${s.ville}` : `Station-service ${s.ville}`,
    url: `https://mon-carburant.com${canonicalPath}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: s.adresse || undefined,
      postalCode: s.cp,
      addressLocality: s.ville,
      addressRegion: dept.region,
      addressCountry: 'FR',
    },
    geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng },
    ...(brandName ? { brand: { '@type': 'Brand', name: brandName } } : {}),
    ...(openingHours.length > 0 ? { openingHoursSpecification: openingHours } : {}),
    ...(FUEL_KEYS.some((f) => s.prices[f] != null)
      ? {
          makesOffer: FUEL_KEYS.filter((f) => s.prices[f] != null).map((f) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: f === 'GPLc' ? 'GPL' : f },
            price: s.prices[f],
            priceCurrency: 'EUR',
            eligibleQuantity: { '@type': 'QuantitativeValue', unitCode: 'LTR', value: 1 },
          })),
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: `https://mon-carburant.com${item.url}`,
    })),
  },
];

if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

// Tableau de répartition par enseigne : on garde la trace de l'enseigne de la
// station courante pour la signaler dans le tableau.
// Enseignes disposant d'une page dédiée. Recalculé ici : le Set construit dans
// getStaticPaths n'est pas visible depuis le rendu.
const brandPageSlugs = new Set((brandsIndex as { slug: string }[]).map((b) => b.slug));

// Lignes du tableau de répartition, entièrement préparées ici : le gabarit se
// contente ensuite d'afficher, sans logique imbriquée.
const brandRows = (brandTable as any[]).map((row: any) => ({
  ...row,
  url: row.slug && brandPageSlugs.has(row.slug) ? `/prix-carburants/enseigne/${row.slug}/` : null,
  isCurrent: !!row.slug && row.slug === s.enseigneSlug,
  avgLabel: row.avg != null ? `${row.avg.toFixed(3)} €` : '-',
  minLabel: row.min != null ? `${row.min.toFixed(3)} €` : '-',
  rowClass: row.slug && row.slug === s.enseigneSlug ? 'is-current' : undefined,
}));
const brandTotal = brandRows.reduce((n: number, r: any) => n + r.count, 0);
const brandNote =
  brandTableScope === 'commune'
    ? `Répartition des ${brandTotal} stations de ${s.ville}. Les prix moyens ne portent que sur les stations qui communiquent un tarif Gazole.`
    : `${s.ville} comptant trop peu de stations pour une répartition utile, ce tableau porte sur l'ensemble du département (${dept.name}, ${brandTotal} stations). Les prix moyens ne portent que sur les stations qui communiquent un tarif Gazole.`;

// « du département Yvelines » est fautif, et le bon article change d'un
// département à l'autre (le Gard, la Gironde, les Yvelines, l'Ain). On
// contourne en repartant de la commune, ce qui parle davantage au visiteur ;
// le périmètre exact est précisé sous le tableau.
const brandHeading =
  brandTableScope === 'commune'
    ? `Les enseignes à ${s.ville}`
    : `Les enseignes autour de ${s.ville}`;

const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}`;

function priceDiff(price: number | null | undefined, fuelKey: string) {
  const nat = national[fuelKey];
  if (price == null || nat == null) return null;
  return ((price - nat) / nat) * 100;
}
---

<BaseLayout title={title} description={description} canonical={canonicalPath} jsonLd={jsonLd} noIndex={isWeak}>
  <div>
    <div class="container" style="padding-top:1rem">
      <nav aria-label="Fil d'ariane" class="breadcrumb-nav">
        {breadcrumb.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> › </span>}
            {i < breadcrumb.length - 1
              ? <a href={item.url}>{item.name}</a>
              : <span aria-current="page">{item.name}</span>
            }
          </>
        ))}
      </nav>
    </div>

    <section class="station-hero">
      <div class="container">
        <div class="hero-head">
          {s.enseigneSlug && <BrandLogo slug={s.enseigneSlug} name={brandName ?? s.enseigneSlug} />}
          <h1>{heading}</h1>
        </div>
        <p class="station-sub">
          {s.cp} {s.ville}
          {s.pop === 'autoroute' && <span class="tag tag-motorway">Autoroute</span>}
          {automate && <span class="tag tag-auto">Automate 24/24</span>}
          {alwaysOpen && <span class="tag tag-open">Ouvert 24h/24</span>}
          {cityRankGazole === 1 && <span class="tag tag-best">Moins chère de {s.ville}</span>}
        </p>
        {lastUpdate && <p class="update-info">Données du {lastUpdate}</p>}
      </div>
    </section>

    <div class="container page-body">
      <!-- Prix du jour -->
      <section class="section-block">
        <h2>Prix des carburants à la pompe</h2>
        <div class="fuel-stats-grid">
          {FUEL_KEYS.map((fuel) => {
            const price = s.prices[fuel] ?? null;
            const diff = priceDiff(price, fuel);
            return (
              <div class={`fuel-stat-card${price == null ? ' is-empty' : ''}`} style={`--fuel-color: ${FUEL_COLORS[fuel]}`}>
                <div class="fsc-label">{fuel === 'GPLc' ? 'GPL' : fuel}</div>
                <div class="fsc-price">
                  {price != null ? price.toFixed(3) : 'n.c.'}
                  {price != null && <span class="fsc-unit">€/L</span>}
                </div>
                {diff != null && (
                  <div class={`fsc-diff ${diff < -2 ? 'badge-green' : diff > 2 ? 'badge-orange' : 'badge-neutral'}`}>
                    {diff > 0 ? '+' : ''}{diff.toFixed(1)}% France
                  </div>
                )}
              </div>
            );
          })}
        </div>
        <p class="price-note">
          Dernière déclaration de la station : <strong>{formatMaj(s.maj)}</strong>.
          Les carburants notés « n.c. » ne sont pas distribués ici ou sont en rupture.
        </p>
        {isWeak && (
          <p class="stale-warning">
            Les informations de prix de cette station sont incomplètes ou anciennes
            ({weakReason}). Vérifiez sur place, ou consultez les stations proches listées plus bas.
          </p>
        )}
      </section>

      <!-- Comparaison -->
      {gazole != null && (
        <section class="section-block">
          <h2>Ce prix est-il intéressant ?</h2>
          <div class="compare-grid">
            <div class="compare-card">
              <div class="cc-label">Cette station</div>
              <div class="cc-value cc-strong">{gazole.toFixed(3)} €/L</div>
            </div>
            {cityStats['Gazole'] != null && (
              <div class="compare-card">
                <div class="cc-label">Moyenne à {s.ville}</div>
                <div class="cc-value">{cityStats['Gazole'].toFixed(3)} €/L</div>
                <div class="cc-delta">{gazole <= cityStats['Gazole'] ? '−' : '+'}{Math.round(Math.abs(gazole - cityStats['Gazole']) * 100)} c/L</div>
              </div>
            )}
            {deptStats['Gazole'] != null && (
              <div class="compare-card">
                <div class="cc-label">Moyenne {dept.name}</div>
                <div class="cc-value">{deptStats['Gazole'].toFixed(3)} €/L</div>
                <div class="cc-delta">{gazole <= deptStats['Gazole'] ? '−' : '+'}{Math.round(Math.abs(gazole - deptStats['Gazole']) * 100)} c/L</div>
              </div>
            )}
            {national['Gazole'] != null && (
              <div class="compare-card">
                <div class="cc-label">Moyenne France</div>
                <div class="cc-value">{national['Gazole'].toFixed(3)} €/L</div>
                <div class="cc-delta">{gazole <= national['Gazole'] ? '−' : '+'}{Math.round(Math.abs(gazole - national['Gazole']) * 100)} c/L</div>
              </div>
            )}
          </div>
          {cityRankGazole != null && cityRankTotal != null && cityRankTotal >= 3 && (
            <p class="rank-note">
              Classement Gazole à {s.ville} : <strong>{cityRankGazole}<sup>e</sup> sur {cityRankTotal}</strong> stations comparées.
            </p>
          )}
        </section>
      )}

      <!-- Localisation -->
      <section class="section-block">
        <h2>Où se trouve cette station ?</h2>
        <StationMiniMap
          lat={s.lat}
          lng={s.lng}
          label={`${stationDisplayName(s)}${s.adresse ? `, ${s.adresse}` : ''}`}
          gazole={gazole}
        />
        <p class="addr-line">
          <strong>{s.adresse || 'Adresse non communiquée'}</strong>, {s.cp} {s.ville}
        </p>
        <a class="cta-directions" href={mapsUrl} target="_blank" rel="noopener nofollow">
          Ouvrir l'itinéraire
        </a>
      </section>

      <!-- Horaires -->
      {weekHours && (
        <section class="section-block">
          <h2>Horaires d'ouverture</h2>
          <table class="hours-table">
            <tbody>
              {weekHours.map((d) => (
                <tr>
                  <th scope="row">{d.day}</th>
                  <td>
                    {d.unknown ? <span class="muted">Non communiqué</span>
                      : d.closed ? <span class="muted">Fermé</span>
                      : d.slots.join(' et ')}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {automate && <p class="hours-note">Un automate carte bancaire reste accessible en dehors de ces horaires.</p>}
        </section>
      )}

      <!-- Services -->
      {services.length > 0 && (
        <section class="section-block">
          <h2>Services proposés</h2>
          <ul class="services-list">
            {services.map((svc) => <li>{svc}</li>)}
          </ul>
        </section>
      )}

      <!-- Répartition par enseigne -->
      {brandRows.length > 1 && (
        <section class="section-block">
          <h2>{brandHeading}</h2>
          <div class="table-wrapper">
            <table class="stations-table brand-table">
              <thead>
                <tr>
                  <th>Enseigne</th>
                  <th>Stations</th>
                  <th>Gazole moyen</th>
                  <th>Le moins cher</th>
                </tr>
              </thead>
              <tbody>
                {brandRows.map((row: any) => (
                  <tr class={row.rowClass}>
                    <td class="brand-cell">
                      <BrandCell slug={row.slug} name={row.name} url={row.url} current={row.isCurrent} />
                    </td>
                    <td><strong>{row.count}</strong></td>
                    <td>{row.avgLabel}</td>
                    <td>{row.minLabel}</td>
                  </tr>
                ))}
                <tr class="total-row">
                  <td>Total</td>
                  <td><strong>{brandTotal}</strong></td>
                  <td></td>
                  <td></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="brand-note">{brandNote}</p>
        </section>
      )}

      <!-- Texte -->
      <section class="section-block seo-text">
        <h2>{stationDisplayName(s)} à {s.ville} : le détail</h2>
        {paragraphs.map((para) => <p>{para}</p>)}
      </section>

      <!-- Stations proches -->
      {nearby.length > 0 && (
        <section class="section-block">
          <h2>Stations les plus proches</h2>
          <div class="table-wrapper">
            <table class="stations-table">
              <thead>
                <tr>
                  <th>Station</th>
                  <th>Commune</th>
                  <th>Distance</th>
                  <th>Gazole</th>
                </tr>
              </thead>
              <tbody>
                {nearby.map((n: any) => (
                  <tr>
                    <td>
                      {n.url
                        ? <a href={n.url}>{n.nom ?? 'Station-service'}{n.adresse ? `, ${n.adresse}` : ''}</a>
                        : <span>{n.nom ?? 'Station-service'}{n.adresse ? `, ${n.adresse}` : ''}</span>}
                    </td>
                    <td>{n.ville}</td>
                    <td>{n.distance < 1 ? `${Math.round(n.distance * 1000)} m` : `${n.distance.toFixed(1)} km`}</td>
                    <td>{n.gazole != null ? `${n.gazole.toFixed(3)} €` : '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- FAQ -->
      {faq.length > 0 && (
        <section class="section-block">
          <h2>Questions fréquentes</h2>
          <div class="faq-list">
            {faq.map((f) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Navigation -->
      <section class="section-block">
        <div class="nav-links">
          {cityHasPage && <a href={`/prix-carburants/ville/${s.villeSlug}/`} class="nav-link">Toutes les stations de {s.ville}</a>}
          <a href={`/prix-carburants/${dept.slug}/`} class="nav-link">{dept.name} ({dept.num})</a>
          {brandHasPage && s.enseigneSlug && <a href={`/prix-carburants/enseigne/${s.enseigneSlug}/`} class="nav-link">Prix {brandName}</a>}
          <a href="/prix-carburants/stations/" class="nav-link">Annuaire des stations</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

