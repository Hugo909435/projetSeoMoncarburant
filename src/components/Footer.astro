---
// Footer - 4 colonnes, aucun lien sortant
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-grid">
    <!-- Colonne 1 : À propos -->
    <div class="footer-col">
      <a href="/" class="footer-logo" aria-label="Mon Carburant - Accueil">
        <img src="/images/logo-transparent.svg" alt="Mon Carburant" class="footer-logo-img" width="36" height="36" />
        <span>Mon<strong>Carburant</strong></span>
      </a>
      <p class="footer-tagline">
        Économisez sur le carburant, roulez plus malin. Conseils, comparatifs et décryptages pour les automobilistes français.
      </p>
    </div>

    <!-- Colonne 2 : Catégories -->
    <div class="footer-col">
      <h3>Thématiques</h3>
      <ul role="list">
        <li><a href="/categorie/economies/">Économies de carburant</a></li>
        <li><a href="/categorie/carburants/">Types de carburants</a></li>
        <li><a href="/categorie/entretien/">Entretien du véhicule</a></li>
        <li><a href="/blog/prix-coutant-carburant-calendrier-leclerc-intermarche-carrefour/">Carburant à prix coûtant</a></li>
        <li><a href="/blog/">Tous les articles</a></li>
        <li><a href="/prix-carburants/">Comparateur carburant</a></li>
      </ul>
    </div>

    <!-- Colonne 3 : Pages légales -->
    <div class="footer-col">
      <h3>Informations</h3>
      <ul role="list">
        <li><a href="/a-propos/">À propos</a></li>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/politique-confidentialite/">Politique de confidentialité</a></li>
        <li><a href="/rss.xml">Flux RSS</a></li>
      </ul>
    </div>

    <!-- Colonne 4 : Contact -->
    <div class="footer-col">
      <h3>Contact</h3>
      <p>Une question, une suggestion ou une opportunité éditoriale ?</p>
      <a href="/contact/" class="footer-cta">Nous contacter</a>
      <div class="footer-socials" aria-label="Réseaux sociaux">
        <a href="https://www.instagram.com/moncarburant/" target="_blank" rel="noopener noreferrer" aria-label="Instagram Mon Carburant">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm4.2 3.3a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4Zm0 2a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm5-2.35a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z" />
          </svg>
        </a>
        <a href="https://x.com/mon_carburant" target="_blank" rel="noopener noreferrer" aria-label="X Mon Carburant">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18.9 2h3.25l-7.1 8.12L23.4 22h-6.54l-5.12-6.7L5.88 22H2.62l7.6-8.7L2.2 2h6.7l4.63 6.12L18.9 2Zm-1.14 17.9h1.8L7.92 4H5.99l11.77 15.9Z" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/mon-carburant-984798431/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Mon Carburant">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.95 1.95 0 1 0 0 3.9 1.95 1.95 0 0 0 0-3.9ZM21 21h-3.38v-6.4c0-1.53-.03-3.5-2.13-3.5-2.13 0-2.46 1.66-2.46 3.38V21H9.66V8.5h3.24v1.7h.05c.45-.86 1.56-1.76 3.21-1.76 3.43 0 4.06 2.26 4.06 5.2V21Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} Mon Carburant, tous droits réservés</p>
      <p class="footer-datasource">
        Source des données : <a href="https://data.economie.gouv.fr" rel="noopener noreferrer" target="_blank">data.economie.gouv.fr</a> (Licence Ouverte)
      </p>
      <nav aria-label="Navigation légale">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-confidentialite/">Confidentialité</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #cbd5e1;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
    }
  }

  .footer-col h3 {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    margin: 0 0 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .footer-logo-img {
    display: block;
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
  }

  .footer-logo:hover {
    color: #fff;
  }

  .footer-logo strong {
    color: var(--color-accent);
    font-weight: 800;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-col p {
    font-size: 0.875rem;
    color: #94a3b8;
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  .footer-cta {
    display: inline-flex;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: #fff !important;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .footer-cta:hover {
    background: #d0651a;
    color: #fff;
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #334155;
    border-radius: 0.375rem;
    color: #94a3b8;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .footer-socials a:hover {
    background: rgba(255 255 255 / 0.08);
    border-color: var(--color-accent);
    color: #fff;
  }

  .footer-socials svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  .footer-bottom {
    border-top: 1px solid #1e3a50;
  }

  .footer-datasource {
    margin: 0;
    font-size: 0.75rem;
    color: #475569;
  }
  .footer-datasource a {
    color: #64748b;
    text-decoration: underline;
  }
  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    font-size: 0.8125rem;
    color: #64748b;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-bottom-inner p {
    margin: 0;
  }

  .footer-bottom nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-bottom nav a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom nav a:hover {
    color: #94a3b8;
  }
</style>
