---
// Boutons de partage natifs - sans tracker externe
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="share-buttons" aria-label="Partager cet article">
  <p class="share-label">Partager</p>

  <!-- Partage natif (mobile) -->
  <button
    class="share-btn share-native"
    data-url={url}
    data-title={title}
    aria-label="Partager cet article"
    type="button"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    Partager
  </button>

  <!-- Copier le lien -->
  <button
    class="share-btn share-copy"
    data-url={url}
    aria-label="Copier le lien de l'article"
    type="button"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    Copier le lien
  </button>
</div>

<script>
  // Partage natif ou fallback copier
  const nativeBtn = document.querySelector<HTMLButtonElement>('.share-native');
  const copyBtn = document.querySelector<HTMLButtonElement>('.share-copy');

  if (nativeBtn) {
    // Masquer si l'API Web Share n'est pas disponible
    if (!navigator.share) {
      nativeBtn.style.display = 'none';
    } else {
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: nativeBtn.dataset.title ?? '',
            url: nativeBtn.dataset.url ?? window.location.href,
          });
        } catch {}
      });
    }
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const original = copyBtn.innerHTML;
        copyBtn.textContent = 'Copié !';
        setTimeout(() => {
          copyBtn.innerHTML = original;
        }, 2000);
      } catch {}
    });
  }
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .share-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: 0;
    margin-right: 0.25rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .share-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: #fff7ed;
  }
</style>
