---
// Composant centralisé pour toutes les balises SEO, Open Graph, JSON-LD
const SITE_URL = 'https://mon-carburant.com';
const SITE_NAME = 'Mon Carburant';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  authorName?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  appendSiteName?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image = '/images/og-default.jpg',
  imageAlt = title,
  type = 'website',
  publishedAt,
  updatedAt,
  authorName,
  noIndex = false,
  jsonLd,
  appendSiteName = true,
} = Astro.props;

const fullTitle = appendSiteName && !title.includes(SITE_NAME)
  ? `${title} - ${SITE_NAME}`
  : title;
const absoluteImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const absoluteCanonical = canonical.startsWith('http') ? canonical : `${SITE_URL}${canonical}`;
const schemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!-- Titre et description -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={absoluteCanonical} />

<!-- Robots -->
<meta
  name="robots"
  content={noIndex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={absoluteCanonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{type === 'article' && publishedAt && (
  <meta property="article:published_time" content={publishedAt} />
)}
{type === 'article' && updatedAt && (
  <meta property="article:modified_time" content={updatedAt} />
)}
{type === 'article' && authorName && (
  <meta property="article:author" content={authorName} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- hreflang français -->
<link rel="alternate" hreflang="fr-FR" href={absoluteCanonical} />
<link rel="alternate" hreflang="x-default" href={absoluteCanonical} />

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  href={`${SITE_URL}/rss.xml`}
  title={`${SITE_NAME} — Flux RSS`}
/>

<!-- JSON-LD schemas -->
{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
