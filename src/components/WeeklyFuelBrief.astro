---
import history from '../data/fuel/price-history.json';
import { weeklyFuelBrief } from '../utils/weekly-fuel-brief.mjs';
const brief = weeklyFuelBrief(history);
const date = (value: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
const decimal = (value: number, digits: number) => value.toLocaleString('fr-FR', { minimumFractionDigits: digits, maximumFractionDigits: digits });
const signed = (value: number, digits: number) => `${value > 0 ? '+' : ''}${decimal(value, digits)}`;
const gazole = brief?.rows.find(row => row.fuel === 'Gazole');
---

{brief && (
  <section id="bilan-hebdomadaire" class="weekly-brief" aria-labelledby="weekly-title">
    <p class="weekly-eyebrow">Le bilan sur sept jours</p>
    <h2 id="weekly-title">Prix des carburants cette semaine : quelle différence sur un plein ?</h2>
    <p>Comparaison du {date(brief.start)} au {date(brief.end)}. Deux relevés journaliers espacés de sept jours.</p>
    {gazole && (
      <p class="weekly-lead">
        {Math.abs(gazole.diff) < 0.0005
          ? <>Le prix moyen du gazole est stable à <strong>{decimal(gazole.current, 3)} €/L</strong> à la précision de nos relevés.</>
          : <>Le gazole a {gazole.diff < 0 ? 'baissé' : 'augmenté'} de <strong>{decimal(Math.abs(gazole.diff) * 100, 1)} centimes par litre</strong>,
            soit <strong>{decimal(Math.abs(gazole.cost50), 2)} € de {gazole.diff < 0 ? 'moins' : 'plus'}</strong> sur un plein de 50 litres au prix moyen national.</>}
      </p>
    )}
    <div class="weekly-table-wrap" role="region" aria-label="Bilan des prix sur sept jours" tabindex="0">
      <table>
        <caption>Variation nationale, non une remise garantie dans chaque station.</caption>
        <thead><tr><th scope="col">Carburant</th><th scope="col">Il y a 7 jours</th><th scope="col">Dernier relevé</th><th scope="col">Écart par litre</th><th scope="col">Écart sur 50 L</th></tr></thead>
        <tbody>
          {brief.rows.map(row => <tr>
            <th scope="row">{row.fuel === 'E10' ? 'SP95-E10' : row.fuel}</th>
            <td>{decimal(row.previous, 3)} €/L</td><td>{decimal(row.current, 3)} €/L</td>
            <td>{signed(row.diff * 100, 1)} c</td><td>{signed(row.cost50, 2)} €</td>
          </tr>)}
        </tbody>
      </table>
    </div>
    <p class="weekly-note">Calculs Mon Carburant à partir du flux public des prix déclarés. Moyennes arithmétiques, sans pondération par les volumes ni panel fixe de stations. L'écart peut aussi refléter un changement des stations déclarantes.</p>
    <p class="weekly-links"><a href="/prix-gazole/">Comparer le gazole près de chez vous →</a><a href="/prix-carburants/">Comparer tous les carburants →</a></p>
  </section>
)}

<style>
  .weekly-brief { margin:0 0 3rem; border-top:3px solid var(--color-primary); padding-top:1.25rem; scroll-margin-top:6rem; }
  .weekly-eyebrow { font-size:.75rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; color:#475569; margin:0 0 .5rem; }
  h2 { color:var(--color-primary); font-size:clamp(1.25rem,3vw,1.65rem); line-height:1.3; margin:0 0 1rem; }
  p { color:#374151; line-height:1.65; }
  .weekly-lead { font-size:1.1rem; max-width:65ch; }
  .weekly-table-wrap { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; font-size:.875rem; font-variant-numeric:tabular-nums; }
  caption { text-align:left; color:#475569; padding-bottom:.75rem; }
  th, td { padding:.75rem; text-align:left; border-bottom:1px solid #e2e8f0; white-space:nowrap; }
  thead th { background:#f1f5f9; color:var(--color-primary); }
  .weekly-note { color:#475569; font-size:.8rem; }
  .weekly-links { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; }
  a { color:var(--color-primary); font-weight:700; min-height:44px; display:inline-flex; align-items:center; }
  a:focus-visible, .weekly-table-wrap:focus-visible { outline:3px solid var(--color-accent); outline-offset:3px; }
</style>
