---
// Bloc pub Google AdSense, respectueux du consentement RGPD (voir CookieBanner.astro).
// Rien ne se charge tant que l'utilisateur n'a pas accepté la catégorie "Publicité" :
// le <ins> reste vide et inerte jusqu'à ce que le script adsbygoogle soit injecté.
//
// TODO avant mise en prod : remplace ADS_SLOT par le data-ad-slot de ton unité
// "Display responsive" créée dans le tableau de bord AdSense (Annonces > Par bloc).
const ADS_CLIENT = 'ca-pub-3886240842343078';
const ADS_SLOT = 'XXXXXXXXXX';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['ad-slot', className]} data-ads-consent-slot>
  <span class="ad-slot__label">Publicité</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={ADS_CLIENT}
    data-ad-slot={ADS_SLOT}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
</div>

<style>
  .ad-slot {
    max-width: 970px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    text-align: center;
    overflow: hidden;
  }
  .ad-slot__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 0.375rem;
  }
</style>
