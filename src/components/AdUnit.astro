---
// Bloc pub Google AdSense. Le script adsbygoogle.js est chargé une fois pour
// toutes dans BaseLayout.astro ; le consentement (RGPD) est géré par le message
// de confidentialité Google (AdSense > Confidentialité et messages) via
// Google Consent Mode, pas par ce composant.
const ADS_CLIENT = 'ca-pub-3886240842343078';
const DEFAULT_SLOT = '9482478582';

interface Props {
  slot?: string;
  class?: string;
  /** true : unité à taille fixe (300x250), pour un emplacement compact (ex.
   *  à côté d'un paragraphe). Google respecte alors la taille imposée au lieu
   *  de redimensionner l'emplacement lui-même via "auto" / full-width-responsive,
   *  qui écrase toute contrainte CSS (max-height) avec un style inline !important. */
  fixedSize?: boolean;
}

const { slot = DEFAULT_SLOT, class: className, fixedSize = false } = Astro.props;
---

<div class:list={['ad-slot', { 'ad-slot-fixed': fixedSize }, className]} data-ads-consent-slot>
  <span class="ad-slot__label">Publicité</span>
  {fixedSize ? (
    <ins
      class="adsbygoogle"
      style="display:inline-block;width:300px;height:250px"
      data-ad-client={ADS_CLIENT}
      data-ad-slot={slot}></ins>
  ) : (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADS_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
  )}
</div>
<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>

<style>
  .ad-slot {
    max-width: 970px;
    min-height: 100px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    text-align: center;
    overflow: hidden;
  }
  .ad-slot-fixed {
    max-width: 300px;
    min-height: 250px;
    margin: 0;
    padding: 0;
  }
  .ad-slot__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 0.375rem;
  }
</style>
