---
// Encart auteur affiché en fin d'article
interface AuthorData {
  name: string;
  slug: string;
  bio: string;
  photo: string;
  photoAlt?: string;
  expertise: string[];
  website?: string;
  linkedin?: string;
  github?: string;
}

interface Props {
  author: AuthorData;
}

const { author } = Astro.props;
---

<div class="author-box">
  <a href={`/auteur/${author.slug}/`} class="author-photo-link" aria-label={`Voir le profil de ${author.name}`}>
    <img
      src={author.photo}
      alt={author.photoAlt ?? `Photo de ${author.name}`}
      width="80"
      height="80"
      loading="lazy"
      decoding="async"
      class="author-photo"
      onerror="this.src='/images/authors/placeholder.svg'"
    />
  </a>
  <div class="author-info">
    <p class="author-label">Rédigé par</p>
    <a href={`/auteur/${author.slug}/`} class="author-name">{author.name}</a>
    <p class="author-bio">{author.bio}</p>
    {author.expertise.length > 0 && (
      <ul class="author-expertise" aria-label="Domaines d'expertise">
        {author.expertise.map((exp) => (
          <li>{exp}</li>
        ))}
      </ul>
    )}
    <div class="author-links">
      {author.website && (
        <a
          href={author.website}
          class="author-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Site web de ${author.name}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Site web
        </a>
      )}
      {author.linkedin && (
        <a
          href={author.linkedin}
          class="author-link author-link--linkedin"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Profil LinkedIn de ${author.name}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      )}
      {author.github && (
        <a
          href={author.github}
          class="author-link author-link--github"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Profil GitHub de ${author.name}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.744.083-.729.083-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.807 1.305 3.492.998.108-.775.42-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .author-box {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-top: 2.5rem;
  }

  .author-photo-link {
    flex-shrink: 0;
  }

  .author-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-accent);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .author-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin: 0;
    font-weight: 600;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .author-name:hover {
    color: var(--color-accent);
  }

  .author-bio {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .author-expertise {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
  }

  .author-expertise li {
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .author-link:hover {
    text-decoration: underline;
  }

  .author-link--linkedin {
    color: #0a66c2;
  }

  .author-link--github {
    color: #181717;
  }

  @media (max-width: 480px) {
    .author-box {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .author-expertise {
      justify-content: center;
    }
  }
</style>
