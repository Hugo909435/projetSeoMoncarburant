---
// 3 articles liés (même silo ou catégorie)
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: CollectionEntry<'blog'>[];
  title?: string;
}

const { articles, title = 'Articles similaires' } = Astro.props;
const displayed = articles.slice(0, 3);
---

{displayed.length > 0 && (
  <section class="related-articles" aria-label={title}>
    <h2 class="related-title">{title}</h2>
    <div class="related-grid">
      {displayed.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
)}

<style>
  .related-articles {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 2px solid var(--color-border);
  }

  .related-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
