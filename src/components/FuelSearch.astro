---
import departments from '../data/departments.json';

// Slug map : numéro département → slug URL
const deptSlugs = Object.fromEntries(
  Object.entries(departments as Record<string, { slug: string; num: string }>)
    .map(([num, d]) => [num, d.slug])
);

// Liste des slugs ville qui ont une page dédiée
const cityFiles = import.meta.glob('../data/fuel/stations-by-city/*.json');
const availableCitySlugs = Object.keys(cityFiles).map(p => p.replace(/^.*\/(.+)\.json$/, '$1'));
---

<section
  class="fuel-search-section"
  aria-label="Rechercher une station"
  data-dept-slugs={JSON.stringify(deptSlugs)}
  data-city-slugs={JSON.stringify(availableCitySlugs)}
>
  <div class="fuel-search-card">
    <div class="fs-controls">
      <div class="fs-input-group">
        <label for="fs-query" class="fs-label">Code postal ou ville</label>
        <div class="fs-input-wrap">
          <svg class="fs-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="text"
            id="fs-query"
            class="fs-input"
            placeholder="Ex : 85000 ou La Roche-sur-Yon"
            maxlength="100"
            autocomplete="postal-code"
          />
        </div>
      </div>

      <div class="fs-input-group">
        <label for="fs-fuel" class="fs-label">Carburant</label>
        <select id="fs-fuel" class="fs-select">
          <option value="Gazole" selected>Gazole</option>
          <option value="SP95">Sans-Plomb 95</option>
          <option value="SP98">Sans-Plomb 98</option>
          <option value="E10">E10 (SP95-E10)</option>
          <option value="E85">E85 (Bioéthanol)</option>
          <option value="GPLc">GPL</option>
        </select>
      </div>

      <div class="fs-actions">
        <button id="fs-search-btn" class="fs-btn-primary" type="button">
          Rechercher
        </button>
      </div>
    </div>

    <div id="fs-loading" class="fs-loading" hidden aria-live="polite">
      <span class="fs-spinner" aria-hidden="true"></span>
      Recherche en cours…
    </div>

    <div id="fs-error" class="fs-error" hidden role="alert"></div>

    <!-- Liste de désambiguïsation (plusieurs villes correspondantes) -->
    <div id="fs-disambiguation" class="fs-disambiguation" hidden>
      <p class="fs-disambiguation-label">Plusieurs villes correspondent, laquelle ?</p>
      <ul id="fs-disambiguation-list" class="fs-disambiguation-list"></ul>
    </div>
  </div>
</section>

<script>
const section = document.querySelector('.fuel-search-section') as HTMLElement;
const deptSlugs: Record<string, string> = JSON.parse(section?.dataset.deptSlugs ?? '{}');
const availableCitySlugs: string[] = JSON.parse(section?.dataset.citySlugs ?? '[]');
const citySlugSet = new Set(availableCitySlugs);

let stationsCache: any[] | null = null;

async function loadStations(): Promise<any[]> {
  if (stationsCache) return stationsCache;
  const resp = await fetch('/data/stations-light.json');
  if (!resp.ok) throw new Error('Impossible de charger les données.');
  stationsCache = await resp.json();
  return stationsCache!;
}

function normalize(str: string): string {
  return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/['\s-]+/g, '-').replace(/^-|-$/g, '');
}

function getDeptNum(cp: string): string {
  const padded = cp.padStart(5, '0');
  return (padded.startsWith('97') || padded.startsWith('98')) ? padded.substring(0, 3) : padded.substring(0, 2);
}

function setLoading(on: boolean) {
  (document.getElementById('fs-loading') as HTMLElement).hidden = !on;
}

function setError(msg: string) {
  const el = document.getElementById('fs-error') as HTMLElement;
  el.textContent = msg;
  el.hidden = !msg;
}

function setDisambiguation(matches: Map<string, string>) {
  const container = document.getElementById('fs-disambiguation') as HTMLElement;
  const list = document.getElementById('fs-disambiguation-list') as HTMLElement;
  list.innerHTML = '';
  matches.forEach((label, slug) => {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = `/prix-carburants/ville/${slug}/`;
    a.textContent = label;
    li.appendChild(a);
    list.appendChild(li);
  });
  container.hidden = false;
}

function clearState() {
  setError('');
  (document.getElementById('fs-disambiguation') as HTMLElement).hidden = true;
}

async function search() {
  const queryInput = document.getElementById('fs-query') as HTMLInputElement;
  const q = queryInput.value.trim();
  if (!q) { setError('Saisissez un code postal ou une ville.'); return; }

  clearState();

  // --- Code postal ---
  if (/^\d{2,5}$/.test(q)) {
    const depNum = getDeptNum(q);
    const slug = deptSlugs[depNum];
    if (slug) {
      window.location.href = `/prix-carburants/${slug}/`;
    } else {
      setError('Département non reconnu pour ce code postal.');
    }
    return;
  }

  // --- Nom de ville ---
  setLoading(true);
  try {
    const stations = await loadStations();
    const qNorm = normalize(q);

    // Trouver tous les villeSlug correspondants
    const found = new Map<string, string>(); // slug → label affiché
    for (const s of stations) {
      if (!s.villeSlug) continue;
      const vNorm = normalize(s.ville);
      if (vNorm === qNorm || vNorm.startsWith(qNorm + '-') || s.villeSlug.startsWith(qNorm)) {
        if (!found.has(s.villeSlug)) {
          found.set(s.villeSlug, `${s.ville} (${s.dep})`);
        }
      }
    }

    if (found.size === 0) {
      setError(`Aucune ville trouvée pour "${q}". Essayez avec un code postal.`);
      return;
    }

    // Séparer ceux qui ont une page dédiée et les autres
    const withPage = new Map<string, string>();
    let fallbackDep: string | null = null;

    for (const [slug, label] of found) {
      if (citySlugSet.has(slug)) {
        withPage.set(slug, label);
      } else if (!fallbackDep) {
        // Récupérer le département de la première station sans page
        const st = stations.find(s => s.villeSlug === slug);
        if (st) fallbackDep = st.dep;
      }
    }

    if (withPage.size === 1) {
      const [slug] = withPage.keys();
      window.location.href = `/prix-carburants/ville/${slug}/`;
    } else if (withPage.size > 1) {
      setDisambiguation(withPage);
    } else {
      // Pas de page ville → page département
      const depSlug = fallbackDep ? deptSlugs[fallbackDep] : null;
      if (depSlug) {
        window.location.href = `/prix-carburants/${depSlug}/`;
      } else {
        setError(`Pas de page disponible pour "${q}". Essayez avec un code postal.`);
      }
    }
  } catch (err: any) {
    setError(err.message || 'Une erreur est survenue.');
  } finally {
    setLoading(false);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('fs-search-btn')?.addEventListener('click', search);
  (document.getElementById('fs-query') as HTMLInputElement)?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') search();
  });
});
</script>

<style>
  .fuel-search-section { margin: 0; }

  .fuel-search-card {
    background: #fff;
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(15, 45, 63, 0.08);
  }

  .fs-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
  }

  .fs-controls {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .fs-controls { grid-template-columns: 1fr 200px auto; align-items: end; }
  }

  .fs-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .fs-input-wrap { position: relative; }

  .fs-input-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: #9ca3af;
    pointer-events: none;
  }

  .fs-input, .fs-select {
    width: 100%;
    padding: 0.7rem 0.75rem;
    border: 2px solid #e2e8f0;
    border-radius: 0.5rem;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
    background: #fff;
  }

  .fs-input { padding-left: 2.5rem; }
  .fs-input:focus, .fs-select:focus { border-color: var(--color-primary); }

  .fs-actions { display: flex; }

  .fs-btn-primary {
    width: 100%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .fs-btn-primary:hover { background: #d0651a; }

  .fs-loading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .fs-spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 3px solid #e2e8f0;
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .fs-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    color: #dc2626;
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .fs-disambiguation {
    margin-top: 1.25rem;
    padding: 1.25rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
  }

  .fs-disambiguation-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .fs-disambiguation-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .fs-disambiguation-list a {
    display: inline-block;
    padding: 0.45rem 1rem;
    background: #fff;
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
  }

  .fs-disambiguation-list a:hover {
    background: var(--color-primary);
    color: #fff;
  }
</style>
