---
// FuelSearch — composant interactif de recherche de stations
// JS vanilla pur, charge les données via fetch sur /data/stations-light.json
---

<section class="fuel-search-section" aria-label="Rechercher une station">
  <div class="fuel-search-card">
    <h2 class="fs-title">Trouver les stations les moins chères près de chez moi</h2>

    <div class="fs-controls">
      <!-- Recherche CP / ville -->
      <div class="fs-input-group">
        <label for="fs-query" class="fs-label">Code postal ou ville</label>
        <div class="fs-input-wrap">
          <svg class="fs-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="text"
            id="fs-query"
            class="fs-input"
            placeholder="Ex : 75001 ou Paris"
            maxlength="100"
            autocomplete="postal-code"
          />
        </div>
      </div>

      <!-- Boutons -->
      <div class="fs-actions">
        <button id="fs-search-btn" class="fs-btn-primary" type="button">
          Rechercher
        </button>
      </div>
    </div>

    <!-- Loading -->
    <div id="fs-loading" class="fs-loading" hidden aria-live="polite">
      <span class="fs-spinner" aria-hidden="true"></span>
      Recherche en cours…
    </div>

    <!-- Erreur -->
    <div id="fs-error" class="fs-error" hidden role="alert"></div>

    <!-- Résultats -->
    <div id="fs-results" class="fs-results" hidden>
      <div id="fs-results-header" class="fs-results-header"></div>
      <ol id="fs-results-list" class="fs-results-list"></ol>
    </div>
  </div>
</section>

<script>
// ============================================================
// FuelSearch — vanilla TypeScript
// ============================================================

interface StationLight {
  id: string;
  cp: string;
  ville: string;
  villeSlug: string;
  adresse: string;
  lat: number;
  lng: number;
  dep: string;
  pop: string;
  prices: Record<string, number>;
}

let stationsCache: StationLight[] | null = null;
let loadingStations = false;
const DEFAULT_FUEL = 'Gazole';

// Haversine distance en km
function haversine(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2
    + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

async function loadStations(): Promise<StationLight[]> {
  if (stationsCache) return stationsCache;
  if (loadingStations) {
    await new Promise<void>(resolve => { const t = setInterval(() => { if (stationsCache) { clearInterval(t); resolve(); } }, 100); });
    return stationsCache!;
  }
  loadingStations = true;
  const resp = await fetch('/data/stations-light.json');
  if (!resp.ok) throw new Error('Impossible de charger les données des stations');
  stationsCache = await resp.json();
  loadingStations = false;
  return stationsCache!;
}

function showLoading(show: boolean) {
  const el = document.getElementById('fs-loading');
  if (el) el.hidden = !show;
}

function showError(msg: string) {
  const el = document.getElementById('fs-error');
  if (!el) return;
  el.textContent = msg;
  el.hidden = !msg;
}

function showResults(stations: StationLight[], fuel: string, refLat: number, refLng: number, label: string) {
  const resultsEl = document.getElementById('fs-results');
  const headerEl = document.getElementById('fs-results-header');
  const listEl = document.getElementById('fs-results-list');
  if (!resultsEl || !headerEl || !listEl) return;

  const fuelLabels: Record<string, string> = {
    Gazole: 'Gazole', SP95: 'SP95', SP98: 'SP98', E10: 'E10', E85: 'E85', GPLc: 'GPL',
  };
  const fuelColors: Record<string, string> = {
    Gazole: '#374151', SP95: '#16a34a', SP98: '#2563eb', E10: '#15803d', E85: '#E87722', GPLc: '#ca8a04',
  };

  // Filtrer stations avec ce carburant + calculer distance
  const withDist = stations
    .filter(s => s.prices[fuel] != null && s.lat && s.lng)
    .map(s => ({ ...s, dist: haversine(refLat, refLng, s.lat, s.lng) }))
    .sort((a, b) => {
      // Trier d'abord par distance (≤ 30km), ensuite par prix
      const distA = a.dist <= 30 ? 0 : a.dist;
      const distB = b.dist <= 30 ? 0 : b.dist;
      if (Math.abs(distA - distB) > 5) return distA - distB;
      return (a.prices[fuel] ?? 99) - (b.prices[fuel] ?? 99);
    })
    .slice(0, 10);

  headerEl.innerHTML = `<strong>${withDist.length}</strong> station${withDist.length > 1 ? 's' : ''} trouvée${withDist.length > 1 ? 's' : ''} près de <em>${label}</em> pour <strong>${fuelLabels[fuel] || fuel}</strong>`;

  listEl.innerHTML = withDist.map((s, i) => {
    const price = s.prices[fuel];
    const distText = s.dist < 1 ? `${(s.dist * 1000).toFixed(0)} m` : `${s.dist.toFixed(1)} km`;
    const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}`;
    const isAuto = s.pop === 'autoroute';
    return `
      <li class="fs-result-item ${i === 0 ? 'fs-result-best' : ''}">
        <div class="fs-result-rank">${i + 1}</div>
        <div class="fs-result-body">
          <div class="fs-result-top">
            <span class="fs-result-price" style="color:${fuelColors[fuel] || '#374151'}">${price!.toFixed(3)} €/L</span>
            <span class="fs-result-dist">${distText}</span>
            ${isAuto ? '<span class="fs-result-badge">Autoroute</span>' : ''}
          </div>
          <div class="fs-result-addr">${s.adresse || '—'}, ${s.ville} (${s.cp})</div>
          <a href="${mapsUrl}" class="fs-result-maps" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Itinéraire Google Maps
          </a>
        </div>
      </li>
    `;
  }).join('');

  resultsEl.hidden = false;
}

async function searchByQuery(query: string, fuel: string) {
  showLoading(true);
  showError('');
  try {
    const stations = await loadStations();
    const q = query.trim();

    // Par code postal
    if (/^\d{2,5}$/.test(q)) {
      const cp = q.padStart(5, '0');
      const dep = cp.length >= 5 ? cp.substring(0, 2) : q;

      // Chercher stations dans ce département
      const depStations = stations.filter(s => s.dep === dep || s.dep === cp.substring(0, 3));

      if (depStations.length === 0) {
        showError(`Aucune station trouvée pour le code postal ${q}. Essayez un autre code.`);
        return;
      }

      // Centre géographique approximatif
      const avgLat = depStations.reduce((a, s) => a + s.lat, 0) / depStations.length;
      const avgLng = depStations.reduce((a, s) => a + s.lng, 0) / depStations.length;

      // Affiner si CP complet : chercher stations avec ce CP exact
      const exactMatch = depStations.filter(s => s.cp === cp);
      const refLat = exactMatch.length > 0
        ? exactMatch.reduce((a, s) => a + s.lat, 0) / exactMatch.length
        : avgLat;
      const refLng = exactMatch.length > 0
        ? exactMatch.reduce((a, s) => a + s.lng, 0) / exactMatch.length
        : avgLng;

      showResults(depStations, fuel, refLat, refLng, q);
    } else {
      // Recherche par nom de ville
      const normalized = q.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const cityStations = stations.filter(s => {
        const v = s.ville.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        return v.includes(normalized) || s.villeSlug.includes(normalized.replace(/\s+/g, '-'));
      });

      if (cityStations.length === 0) {
        showError(`Aucune station trouvée pour "${q}". Essayez avec un code postal.`);
        return;
      }

      const refLat = cityStations.reduce((a, s) => a + s.lat, 0) / cityStations.length;
      const refLng = cityStations.reduce((a, s) => a + s.lng, 0) / cityStations.length;
      showResults(cityStations, fuel, refLat, refLng, q);
    }
  } catch (err: any) {
    showError(err.message || 'Une erreur est survenue. Réessayez.');
  } finally {
    showLoading(false);
  }
}

// Initialisation
document.addEventListener('DOMContentLoaded', () => {
  const searchBtn = document.getElementById('fs-search-btn');
  const queryInput = document.getElementById('fs-query') as HTMLInputElement;

  searchBtn?.addEventListener('click', () => {
    const q = queryInput?.value ?? '';
    if (!q.trim()) { showError('Saisissez un code postal ou une ville.'); return; }
    searchByQuery(q, DEFAULT_FUEL);
  });

  queryInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      const q = queryInput.value;
      if (!q.trim()) { showError('Saisissez un code postal ou une ville.'); return; }
      searchByQuery(q, DEFAULT_FUEL);
    }
  });

});
</script>

<style>
  .fuel-search-section { margin: 0; }
  .fuel-search-card {
    background: #fff;
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(15, 45, 63, 0.08);
  }
  .fs-title { font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin: 0 0 1.5rem; }
  .fs-controls { display: flex; flex-direction: column; gap: 1.25rem; }
  .fs-label { display: block; font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 0.4rem; }
  .fs-input-wrap { position: relative; }
  .fs-input-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }
  .fs-input {
    width: 100%; padding: 0.7rem 0.75rem 0.7rem 2.5rem;
    border: 2px solid #e2e8f0; border-radius: 0.5rem; font-size: 1rem;
    outline: none; transition: border-color 0.2s; box-sizing: border-box;
  }
  .fs-input:focus { border-color: var(--color-primary); }
  .fs-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .fs-btn-primary {
    flex: 1; min-width: 140px; background: var(--color-accent); color: #fff;
    border: none; border-radius: 0.5rem; padding: 0.75rem 1.25rem;
    font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.2s;
  }
  .fs-btn-primary:hover { background: #d0651a; }
  .fs-loading { display: flex; align-items: center; gap: 0.75rem; padding: 1.25rem; color: var(--color-text-muted); font-size: 0.9rem; margin-top: 1rem; }
  .fs-spinner {
    display: inline-block; width: 20px; height: 20px;
    border: 3px solid #e2e8f0; border-top-color: var(--color-accent);
    border-radius: 50%; animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .fs-error { background: #fef2f2; border: 1px solid #fecaca; border-radius: 0.5rem; padding: 0.875rem 1rem; color: #dc2626; font-size: 0.875rem; margin-top: 1rem; }
  .fs-results { margin-top: 1.5rem; }
  .fs-results-header { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .fs-results-header strong { color: var(--color-primary); }
  .fs-results-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .fs-result-item { display: flex; gap: 1rem; padding: 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.625rem; transition: box-shadow 0.15s; }
  .fs-result-item:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
  .fs-result-best { border-color: #fbbf24; background: #fffbeb; }
  .fs-result-rank { flex-shrink: 0; width: 28px; height: 28px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; }
  .fs-result-best .fs-result-rank { background: #d97706; }
  .fs-result-body { flex: 1; min-width: 0; }
  .fs-result-top { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.25rem; }
  .fs-result-price { font-size: 1.25rem; font-weight: 800; }
  .fs-result-dist { font-size: 0.8125rem; color: var(--color-text-muted); font-weight: 600; }
  .fs-result-badge { font-size: 0.7rem; background: #fef3c7; color: #92400e; padding: 0.1rem 0.5rem; border-radius: 999px; font-weight: 600; }
  .fs-result-addr { font-size: 0.875rem; color: #374151; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 0.35rem; }
  .fs-result-maps { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8125rem; color: var(--color-accent); text-decoration: none; font-weight: 600; }
  .fs-result-maps:hover { text-decoration: underline; }
</style>
