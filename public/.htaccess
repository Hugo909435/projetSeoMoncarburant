# Page 404 personnalisée
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# HTTP → HTTPS (301 permanent)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redirection www → non-www (301 permanent)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Sécurité : En-têtes HTTP
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://unpkg.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"
</IfModule>

# Cache : Assets Astro hachés (JS, CSS, fonts) → 1 an immuable
# Note : <FilesMatch> ne teste que le nom de fichier (basename), jamais le
# chemin. Un pattern "^_astro/..." ne matche donc jamais rien : on scope via
# SetEnvIf sur Request_URI à la place.
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/_astro/" IS_HASHED_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET

    # Vendor JS/CSS (Leaflet) : non hachés mais versionnés manuellement.
    # Si mis à jour, renommer le dossier/fichier pour invalider le cache.
    SetEnvIf Request_URI "^/vendor/" IS_VENDOR_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_VENDOR_ASSET
</IfModule>

# Compression texte (HTML, CSS, JS, JSON, SVG)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Cache : Images → 1 mois
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/webp          "access plus 1 month"
    ExpiresByType image/jpeg          "access plus 1 month"
    ExpiresByType image/png           "access plus 1 month"
    ExpiresByType image/svg+xml       "access plus 1 month"
    ExpiresByType image/gif           "access plus 1 month"
    ExpiresByType image/x-icon        "access plus 1 month"

    # Fontes (stables — jamais modifiées)
    ExpiresByType font/woff2          "access plus 1 year"
    ExpiresByType font/woff           "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf            "access plus 1 year"
    ExpiresByType font/otf            "access plus 1 year"

    # HTML → revalidation toutes les heures (prix mis à jour quotidiennement)
    ExpiresByType text/html           "access plus 1 hour"

    # JSON data → pas de cache (mis à jour chaque jour)
    ExpiresByType application/json    "access plus 0 seconds"
</IfModule>

# JSON data : pas de cache côté navigateur
<IfModule mod_headers.c>
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
